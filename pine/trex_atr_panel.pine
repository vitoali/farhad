// برای ATR دقیق خاکستر این اندیکاتور را مستقیم Add کنید:
//   Trex [MrD3v] — https://www.tradingview.com/script/wv9EwdkR-Trex-MrD3v/
// راهنما: docs/trex-atr-tradingview-fa.md
//
//@version=5
indicator("TRex — use MrD3v community indicator", overlay=true)

showHint = input.bool(true, "Show setup hint")

if showHint and barstate.islast
    label.new(bar_index, high, "ATR: Add 'Trex [MrD3v]' from Indicators\nhttps://www.tradingview.com/script/wv9EwdkR-Trex-MrD3v/", style=label.style_label_down, color=color.new(color.purple, 15), textcolor=color.white, size=size.normal)
