//@version=5
indicator("TRex ATR — Use Community Indicator", overlay=true)

showHint = input.bool(true, "Show setup hint on chart")

if showHint and barstate.islast
    label.new(bar_index, high, "ATR: Add 'ATR TRex [ipooya]' from Indicators\n(docs/trex-atr-tradingview-fa.md)", style=label.style_label_down, color=color.new(color.purple, 20), textcolor=color.white, size=size.normal)
