// Nison candlestick scanner — marks patterns with lines + kind tags (no pattern names).
// Publish pine/nison_candlestick_patterns.pine as a library first, then fix import below.
//@version=5
indicator("Nison Pattern Scanner", overlay=true, max_labels_count=500, max_lines_count=500)

import farhad/NisonCandlestickPatterns/2 as nison

// ── Settings ───────────────────────────────────────────────────────────────────
grpGeneral = "General"
dojiPct     = input.float(0.10, "Doji threshold (% range)", minval=0.01, maxval=0.30, step=0.01, group=grpGeneral)
smallBody   = input.float(0.30, "Small body (% range)", minval=0.10, maxval=0.50, step=0.01, group=grpGeneral)
longBody    = input.float(0.60, "Long body (% range)", minval=0.40, maxval=0.90, step=0.01, group=grpGeneral)
shadowRatio = input.float(2.0, "Shadow ratio (hammer/star)", minval=1.0, maxval=4.0, step=0.1, group=grpGeneral)
trendBars   = input.int(5, "Trend lookback", minval=2, maxval=20, group=grpGeneral)
longTerm    = input.int(20, "Long-term pattern lookback", minval=10, maxval=60, group=grpGeneral)

grpDisplay = "Display"
showMarks   = input.bool(true, "Show lines and tags", group=grpDisplay)
showTable   = input.bool(true, "Show summary table", group=grpDisplay)
lineLen     = input.int(3, "Marker line length (bars)", minval=1, maxval=10, group=grpDisplay)
atrMult     = input.float(0.15, "Tag offset (× ATR)", minval=0.05, maxval=0.5, step=0.05, group=grpDisplay)
tagSize     = input.string(size.tiny, "Tag size", options=[size.tiny, size.small], group=grpDisplay)

grpColors = "Colors"
reversalColor     = input.color(color.new(#2962FF, 0), "Reversal", group=grpColors)
continuationColor = input.color(color.new(#00897B, 0), "Continuation", group=grpColors)
contextColor      = input.color(color.new(#F9A825, 0), "Context", group=grpColors)

grpFilter = "Pattern groups"
showSingle = input.bool(true, "Single-candle", group=grpFilter)
showDouble = input.bool(true, "Two-candle", group=grpFilter)
showTriple = input.bool(true, "Three-candle", group=grpFilter)
showMulti  = input.bool(true, "Multi / long-term", group=grpFilter)

s = nison.Settings.new(dojiPct, smallBody, longBody, shadowRatio, 0.50, smallBody, 0.001, trendBars, longTerm)
atr = ta.atr(14)

inCategory(int id) =>
    single = id <= 13
    double = id >= 14 and id <= 36
    triple = id >= 37 and id <= 55
    multi  = id >= 56
    (single and showSingle) or (double and showDouble) or (triple and showTriple) or (multi and showMulti)

kindColor(int id) =>
    k = nison.patternKind(id)
    k == 1 ? continuationColor : k == 2 ? contextColor : reversalColor

// Bullish → below; bearish → above; context → above in uptrend, below in downtrend
markAbove(int id) =>
    nison.patternBearish(id) ? true : nison.patternBullish(id) ? false : nison.inUptrend(s)

markY(int id, int stack) =>
    pad = atr * atrMult * (stack + 1)
    markAbove(id) ? high + pad : low - pad

// ── Draw markers on each bar ───────────────────────────────────────────────────
if showMarks
    int stack = 0
    for i = 0 to nison.patternCount(s)
        if nison.isPatternActive(i, s) and inCategory(i) and stack < 8
            col = kindColor(i)
            y = markY(i, stack)
            tag = nison.patternKindName(i)
            x2 = bar_index + lineLen
            line.new(bar_index, y, x2, y, xloc.bar_index, extend.none, col, line.style_solid, 2)
            lblStyle = markAbove(i) ? label.style_label_down : label.style_label_up
            label.new(x2, y, tag, xloc.bar_index, yloc.price, col, lblStyle, color.white, tagSize)
            stack += 1

// ── Summary table (English) ────────────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 85), border_width=1)

if barstate.islast and showTable
    int nRev = 0
    int nCont = 0
    int nCtx = 0
    for i = 0 to nison.patternCount(s)
        if nison.isPatternActive(i, s) and inCategory(i)
            k = nison.patternKind(i)
            nRev += k == 0 ? 1 : 0
            nCont += k == 1 ? 1 : 0
            nCtx += k == 2 ? 1 : 0
    table.cell(info, 0, 0, "Active patterns", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, str.tostring(nRev + nCont + nCtx), text_color=color.yellow, text_size=size.small)
    table.cell(info, 0, 1, "Reversal", text_color=reversalColor, text_size=size.tiny)
    table.cell(info, 1, 1, str.tostring(nRev), text_color=reversalColor, text_size=size.tiny)
    table.cell(info, 0, 2, "Continuation", text_color=continuationColor, text_size=size.tiny)
    table.cell(info, 1, 2, str.tostring(nCont), text_color=continuationColor, text_size=size.tiny)
    table.cell(info, 0, 3, "Context", text_color=contextColor, text_size=size.tiny)
    table.cell(info, 1, 3, str.tostring(nCtx), text_color=contextColor, text_size=size.tiny)

// ── Strategy exports ───────────────────────────────────────────────────────────
plot(nison.firstActivePattern(s), "First Pattern ID", display=display.none)
plot(nison.activePatternTotal(s), "Active Count", display=display.none)

alertcondition(nison.isPatternActive(14, s), "Reversal bullish", "Bullish reversal pattern")
alertcondition(nison.isPatternActive(15, s), "Reversal bearish", "Bearish reversal pattern")
alertcondition(nison.isPatternActive(51, s), "Continuation bullish", "Bullish continuation pattern")
alertcondition(nison.isPatternActive(52, s), "Continuation bearish", "Bearish continuation pattern")
alertcondition(nison.isPatternActive(0, s), "Context doji", "Context-dependent pattern")
