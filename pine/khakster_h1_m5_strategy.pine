// Khakster H1/M5 Strategy — ساختار H1 + ورود FTC/RTP روی M5
// Chart: M5 | Publish: KhaksterTrexAtrLib + MarketStructureEngine + KhaksterEntryLib
//
//@version=5
strategy("Khakster H1/M5 Entry", overlay=true, pyramiding=0, default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.02)

import YOUR_USER/KhaksterTrexAtrLib/1 as trex
import YOUR_USER/MarketStructureEngine/1 as mse
import YOUR_USER/KhaksterEntryLib/1 as entry

grp = "Fractal stack"
eS = entry.defaultEntrySettings()
showStack = input.bool(true, "Show H1/M15/M5 label", group=grp)

mseS = mse.defaultMseSettings()

type WatchedLevel
    int birthTime
    float pivotPrice
    float zoneTop
    float zoneBot
    float ftcTop
    float ftcBot
    float rtpTop
    float rtpBot
    bool ftcCredible
    bool isHigh
    float thPips
    bool ftcSpent
    bool rtpSet
    bool broken
    bool tradedFtc
    bool tradedRtp

var array<WatchedLevel> watchLv = array.new<WatchedLevel>()
var int lastBearTime = 0
var int lastBullTime = 0

string stTf = eS.structureTf
int stLen = trex.lenForTf(stTf, mseS.atr)
float stBoost = trex.thBoostForLen(stLen, mseS.atr)

[bSig, bTop, bBot, bPrice, bTime, bHi, bInTop, bInBot, bFtcT, bFtcB, bFc, bSc, bKind, bTh] = request.security(syminfo.tickerid, stTf, mse.bearLevelPack(mseS, stLen, stBoost, stTf), barmerge.gaps_off, barmerge.lookahead_off)
[uSig, uTop, uBot, uPrice, uTime, uHi, uInTop, uInBot, uFtcT, uFtcB, uFc, uSc, uKind, uTh] = request.security(syminfo.tickerid, stTf, mse.bullLevelPack(mseS, stLen, stBoost, stTf), barmerge.gaps_off, barmerge.lookahead_off)

spawnLevel(int sig, float zTop, float zBot, float price, int bTime, bool isHigh, float ftcT, float ftcB, int fc, int sc, int kind, float th) =>
    if entry.levelEligible(sig, sc, kind, fc, eS) and bTime != 0
        array.push(watchLv, WatchedLevel.new(bTime, price, zTop, zBot, ftcT, ftcB, na, na, fc == 1, isHigh, th, false, false, false, false, false))

if bSig == 1 and bSig[1] != 1 and bTime != lastBearTime
    lastBearTime := bTime
    spawnLevel(bSig, bTop, bBot, bPrice, bTime, true, bFtcT, bFtcB, bFc, bSc, bKind, bTh)

if uSig == 1 and uSig[1] != 1 and uTime != lastBullTime
    lastBullTime := uTime
    spawnLevel(uSig, uTop, uBot, uPrice, uTime, false, uFtcT, uFtcB, uFc, uSc, uKind, uTh)

if array.size(watchLv) > 0
    for i = 0 to array.size(watchLv) - 1
        WatchedLevel lv = array.get(watchLv, i)
        if not lv.broken
            int ent = entry.scanEntry(lv.isHigh, high, low, high[1], low[1], lv.ftcTop, lv.ftcBot, lv.rtpTop, lv.rtpBot, lv.ftcCredible, mse.PIVOT_REVERSE, lv.broken, lv.ftcSpent, lv.rtpSet, lv.tradedFtc, lv.tradedRtp, eS)
            if ent != entry.ENTRY_NONE and strategy.position_size == 0
                [sl, tp] = entry.entrySlTp(lv.isHigh, lv.zoneTop, lv.zoneBot, lv.pivotPrice, lv.thPips, eS)
                string tag = entry.entryKindName(ent) + " " + trex.tfLabel(stTf)
                if lv.isHigh
                    strategy.entry("S", strategy.short, comment=tag)
                    strategy.exit("XS", "S", stop=sl, limit=tp)
                    lv.tradedFtc := ent == entry.ENTRY_FTC ? true : lv.tradedFtc
                    lv.tradedRtp := ent == entry.ENTRY_RTP ? true : lv.tradedRtp
                else
                    strategy.entry("L", strategy.long, comment=tag)
                    strategy.exit("XL", "L", stop=sl, limit=tp)
                    lv.tradedFtc := ent == entry.ENTRY_FTC ? true : lv.tradedFtc
                    lv.tradedRtp := ent == entry.ENTRY_RTP ? true : lv.tradedRtp
            bool newFtc = not lv.ftcSpent and entry.priceInZone(high, low, lv.ftcTop, lv.ftcBot) and not entry.priceInZone(high[1], low[1], lv.ftcTop, lv.ftcBot)
            if newFtc
                lv.ftcSpent := true
                if not lv.rtpSet
                    [rTop, rBot] = entry.rtpFromBar(lv.isHigh, open, high, low, close)
                    lv.rtpTop := rTop
                    lv.rtpBot := rBot
                    lv.rtpSet := true
            if entry.priceBreakZone(lv.isHigh, close, lv.zoneTop, lv.zoneBot)
                lv.broken := true
            array.set(watchLv, i, lv)
    while array.size(watchLv) > eS.maxWatched
        array.shift(watchLv)

if showStack and barstate.islast
    label.new(bar_index, high, entry.stackLabel(eS), style=label.style_label_down, color=color.new(color.teal, 20), textcolor=color.white, size=size.small)

if barstate.islast and array.size(watchLv) > 0
    for i = 0 to array.size(watchLv) - 1
        WatchedLevel lv = array.get(watchLv, i)
        if not lv.broken and not lv.tradedFtc and lv.ftcCredible and lv.ftcTop > lv.ftcBot
            box.new(lv.birthTime, lv.ftcTop, time, lv.ftcBot, xloc=xloc.bar_time, border_color=color.new(mse.ftcColor(), 50), bgcolor=color.new(mse.ftcColor(), 93), border_width=1)
