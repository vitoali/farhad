// Khakster Smart Money Library — همگرایی Liquidity + SMC/OB + Volume Profile
// منطق الهام‌گرفته از LuxAlgo (Liquidity Sweeps, SMC) و Volume Profile (LonesomeTheBlue)
// برای استفاده در استراتژی: وقتی ۲ یا ۳ سیگنال سطح Khakster را تأیید کنند
//
//@version=5
library("KhaksterSmartMoneyLib", overlay=true)

export const int SIG_LIQUIDITY = 1
export const int SIG_ORDERBLOCK = 2
export const int SIG_VOLUME = 4

export type SmartMoneySettings
    int swingLen
    int volBars
    int volRows
    float vaPercent
    int internalLen
    int minConfirmations
    int maxSweepAge
    int maxObKeep

export defaultSmartMoneySettings() =>
    SmartMoneySettings.new(5, 150, 24, 70.0, 5, 2, 300, 8)

export zonesOverlap(float t1, float b1, float t2, float b2) =>
    not (b1 > t2 or t1 < b2)

export overlapRatio(float t1, float b1, float t2, float b2) =>
    float h1 = t1 - b1
    float top = math.min(t1, t2)
    float bot = math.max(b1, b2)
    h1 <= 0 ? 0.0 : math.max(top - bot, 0.0) / h1

// ── Volume Profile (POC + Value Area) ─────────────────────────────────────────
export calcVolumeNodes(int bbars, int cnum, float pct) =>
    float top = ta.highest(bbars)
    float bot = ta.lowest(bbars)
    if top <= bot or cnum < 2
        [na, na, na]
    else
        float step = (top - bot) / cnum
        float[] totals = array.new_float(cnum, 0.0)
        for bars = 0 to bbars - 1
            float bodyTop = math.max(close[bars], open[bars])
            float bodyBot = math.min(close[bars], open[bars])
            float topwick = high[bars] - bodyTop
            float bottomwick = bodyBot - low[bars]
            float body = bodyTop - bodyBot
            float denom = 2.0 * topwick + 2.0 * bottomwick + body
            float bodyvol = denom > 0 ? body * volume[bars] / denom : 0.0
            for x = 0 to cnum - 1
                float lvlBot = bot + step * x
                float lvlTop = bot + step * (x + 1)
                float add = bodyvol
                if lvlTop > bodyBot and lvlBot < bodyTop
                    array.set(totals, x, array.get(totals, x) + add)
        int poc = 0
        float pocVol = array.get(totals, 0)
        for x = 1 to cnum - 1
            float v = array.get(totals, x)
            if v > pocVol
                pocVol := v
                poc := x
        float totalMax = array.sum(totals) * pct / 100.0
        float vaTot = array.get(totals, poc)
        int up = poc
        int dn = poc
        for x = 0 to cnum - 1
            if vaTot >= totalMax
                break
            float upper = up < cnum - 1 ? array.get(totals, up + 1) : 0.0
            float lower = dn > 0 ? array.get(totals, dn - 1) : 0.0
            if upper == 0 and lower == 0
                break
            if upper >= lower
                vaTot += upper
                up += 1
            else
                vaTot += lower
                dn -= 1
        float pocLvl = bot + step * (poc + 0.5)
        float vaTop = bot + step * (up + 1)
        float vaBot = bot + step * dn
        [pocLvl, vaTop, vaBot]

export volumeConfirmsZone(float zTop, float zBot, float poc, float vaTop, float vaBot, float minRatio) =>
    bool pocIn = poc >= zBot and poc <= zTop
    bool vaHit = zonesOverlap(vaTop, vaBot, zTop, zBot) and overlapRatio(zTop, zBot, vaTop, vaBot) >= minRatio
    pocIn or vaHit

// ── Liquidity Sweeps ───────────────────────────────────────────────────────────
export type SweepZone
    float top
    float bot
    int bias
    int birthBar

export liquiditySweepUpdate(int len, int maxAge, array<SweepZone> zones) =>
    float ph = ta.pivothigh(len, len)
    float pl = ta.pivotlow(len, len)
    if not na(ph)
        array.unshift(zones, SweepZone.new(ph, ph, -1, bar_index - len))
    if not na(pl)
        array.unshift(zones, SweepZone.new(pl, pl, 1, bar_index - len))
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0
            SweepZone z = array.get(zones, i)
            bool remove = bar_index - z.birthBar > maxAge
            if z.bias == -1
                if high > z.top and close < z.top
                    array.set(zones, i, SweepZone.new(high, z.bot, -1, z.birthBar))
                    z := array.get(zones, i)
                if close > z.top
                    remove := true
            else
                if low < z.bot and close > z.bot
                    array.set(zones, i, SweepZone.new(z.top, low, 1, z.birthBar))
                    z := array.get(zones, i)
                if close < z.bot
                    remove := true
            if remove
                array.remove(zones, i)

export liquidityConfirmsZone(float zTop, float zBot, bool isHigh, array<SweepZone> zones, float minRatio) =>
    bool ok = false
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            SweepZone z = array.get(zones, i)
            float st = z.top
            float sb = z.bot
            if st < sb
                float tmp = st
                st := sb
                sb := tmp
            bool dirOk = isHigh ? z.bias == -1 : z.bias == 1
            if dirOk and zonesOverlap(st, sb, zTop, zBot) and overlapRatio(zTop, zBot, st, sb) >= minRatio
                ok := true
    ok

// ── Order Blocks (ساده‌شده SMC داخلی) ───────────────────────────────────────
export type ObZone
    float top
    float bot
    int bias
    int birthBar

export legDir(int size) =>
    int d = 0
    bool newHigh = high[size] > ta.highest(size)
    bool newLow = low[size] < ta.lowest(size)
    if newHigh
        d := -1
    else if newLow
        d := 1
    d

export orderBlockUpdate(int size, int maxKeep, array<ObZone> blocks) =>
    int d = legDir(size)
    bool newLeg = ta.change(d) != 0
    if newLeg
        float obTop = na
        float obBot = na
        int bias = 0
        if d == 1
            obTop := math.max(open[size], close[size])
            obBot := math.min(open[size], close[size])
            bias := 1
        else if d == -1
            obTop := math.max(open[size], close[size])
            obBot := math.min(open[size], close[size])
            bias := -1
        if not na(obTop)
            array.unshift(blocks, ObZone.new(obTop, obBot, bias, bar_index - size))
    if array.size(blocks) > maxKeep
        array.pop(blocks)
    if array.size(blocks) > 0
        for i = array.size(blocks) - 1 to 0
            ObZone b = array.get(blocks, i)
            bool mit = b.bias == 1 ? close < b.bot : close > b.top
            if mit
                array.remove(blocks, i)

export orderBlockConfirmsZone(float zTop, float zBot, bool isHigh, array<ObZone> blocks, float minRatio) =>
    bool ok = false
    int want = isHigh ? -1 : 1
    if array.size(blocks) > 0
        for i = 0 to array.size(blocks) - 1
            ObZone b = array.get(blocks, i)
            if b.bias == want and zonesOverlap(b.top, b.bot, zTop, zBot) and overlapRatio(zTop, zBot, b.top, b.bot) >= minRatio
                ok := true
    ok

// ── همگرایی نهایی ───────────────────────────────────────────────────────────
export type SmartMoneyState
    array<SweepZone> sweeps
    array<ObZone> blocks
    float poc
    float vaTop
    float vaBot

export newSmartMoneyState() =>
    SmartMoneyState.new(array.new<SweepZone>(), array.new<ObZone>(), na, na, na)

export tickSmartMoney(SmartMoneyState st, SmartMoneySettings s) =>
    liquiditySweepUpdate(s.swingLen, s.maxSweepAge, st.sweeps)
    orderBlockUpdate(s.internalLen, s.maxObKeep, st.blocks)
    [poc, vaT, vaB] = calcVolumeNodes(s.volBars, s.volRows, s.vaPercent)
    st.poc := poc
    st.vaTop := vaT
    st.vaBot := vaB
    st

export zoneConfluence(SmartMoneyState st, float zTop, float zBot, bool isHigh, SmartMoneySettings s) =>
    float minR = 0.15
    bool liq = liquidityConfirmsZone(zTop, zBot, isHigh, st.sweeps, minR)
    bool ob = orderBlockConfirmsZone(zTop, zBot, isHigh, st.blocks, minR)
    bool vol = volumeConfirmsZone(zTop, zBot, st.poc, st.vaTop, st.vaBot, minR)
    int cnt = (liq ? 1 : 0) + (ob ? 1 : 0) + (vol ? 1 : 0)
    bool ok = cnt >= s.minConfirmations
    [ok, cnt, liq, ob, vol]

// Pack برای استراتژی: confirmed, count, liq, ob, vol
export confluencePack(SmartMoneyState st, float zTop, float zBot, bool isHigh, SmartMoneySettings s) =>
    [ok, cnt, liq, ob, vol] = zoneConfluence(st, zTop, zBot, isHigh, s)
    [ok ? 1 : 0, cnt, liq ? 1 : 0, ob ? 1 : 0, vol ? 1 : 0]

// برای request.security روی HTF: SM همان تایم‌فریم سطح (نه چارت تریگر)
export confluencePackAtZone(float zTop, float zBot, bool isHigh, SmartMoneySettings s) =>
    var SmartMoneyState st = newSmartMoneyState()
    st := tickSmartMoney(st, s)
    confluencePack(st, zTop, zBot, isHigh, s)

export confluenceLabel(int cnt, bool liq, bool ob, bool vol) =>
    "SM " + str.tostring(cnt) + "/3" + (liq ? " L" : "") + (ob ? " OB" : "") + (vol ? " V" : "")
