//@version=6
strategy("Monster Trex Vol", shorttitle="MTrexVol", overlay=true, pyramiding=0, max_labels_count=500, max_boxes_count=200,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=10000,
     commission_type=strategy.commission.percent, commission_value=0.02)

import dorkadehali/KhaksterTrexAtrLib/1 as trex
import dorkadehali/MarketStructureEngine/1 as mse
import dorkadehali/KhaksterEntryLib/1 as entry
import dorkadehali/KhaksterSmartMoneyLib/1 as sm
import dorkadehali/CandleRecognitionLib/1 as cr

// ── جفت تایم‌فریم ───────────────────────────────────────────────────────────
grpPair = "TF Pair"
pairMode = input.string("H1 + M5", "Structure + Trigger", options=["H4 + M15", "H1 + M5", "D + H1", "W + H4"], group=grpPair)

tfTriplet(string mode) =>
    switch mode
        "H4 + M15" => ["240", "15", "60"]
        "D + H1"   => ["D", "60", "240"]
        "W + H4"   => ["W", "240", "D"]
        => ["60", "5", "15"]

[stTf, trTf, patTf] = tfTriplet(pairMode)

grpHtf = "HTF scan (ساختار خاکستر)"
useMn = input.bool(false, "Mn", group=grpHtf, inline="htf")
useW1 = input.bool(true, "W1", group=grpHtf, inline="htf")
useD1 = input.bool(true, "D1", group=grpHtf, inline="htf")
useH4 = input.bool(true, "H4", group=grpHtf, inline="htf2")
useH1 = input.bool(true, "H1", group=grpHtf, inline="htf2")

grpSm = "Smart Money"
minSm = input.int(1, "Min SM confirmations", minval=1, maxval=3, group=grpSm)

grpEntry = "Entry"
minScore = input.int(40, "Min structure score", group=grpEntry)
useFtcRtp = input.bool(true, "FTC / RTP trigger", group=grpEntry)
useCandle = input.bool(true, "Candle pattern in zone (64)", group=grpEntry)
patFa = input.bool(true, "Pattern label Persian", group=grpEntry)
slMult = input.float(0.5, "SL = TH ×", minval=0.1, step=0.1, group=grpEntry)
tpMult = input.float(3.0, "TP = TH ×", minval=1.0, step=0.5, group=grpEntry)

// ── Trend Filter (پیش‌شرط ورود — 1h + 4h) ───────────────────────────────────
grpTrend = "🧭 Trend Filter (Prerequisite)"
useTrendF  = input.bool(true, "Enable 1h+4h Trend Gate", group=grpTrend)
string mktPreset = input.string("auto", "Market Preset", options=["auto", "crypto", "forex"], group=grpTrend)
string trendRule = input.string("both_agree", "Trend Rule",
     options=["both_agree", "4h_lead", "1h_lead"], group=grpTrend)
bool block4hCh = input.bool(true, "Block counter-trend vs 4h", group=grpTrend)

bool isForex = mktPreset == "forex" or (mktPreset == "auto" and syminfo.type == "forex")

f_trend_pack(bool forex, bool is4h) =>
    float wBj  = forex ? (is4h ? 0.75 : 1.0) : (is4h ? 1.25 : 1.0)
    float wLiq = forex ? (is4h ? 3.0  : 2.0) : (is4h ? 2.5  : 2.0)
    float wSmc = forex ? 0.5 : (is4h ? 2.0 : 0.75)
    float wPb  = forex ? (is4h ? 1.0 : 2.0) : (is4h ? 0.75 : 1.0)
    float wIc  = forex ? (is4h ? 0.25 : 0.75) : (is4h ? 0.5 : 1.5)
    float minL = forex ? (is4h ? 0.58 : 0.55) : (is4h ? 0.60 : 0.55)
    float minS = minL
    float adxF = forex ? (is4h ? 20.0 : 18.0) : (is4h ? 20.0 : 18.0)
    float ema21 = ta.ema(close, 21)
    float ema50 = ta.ema(close, 50)
    float ema34 = ta.ema(close, 34)
    float ema144 = ta.ema(close, 144)
    float ema30 = ta.ema(close, 30)
    float ema100 = ta.ema(close, 100)
    bool bjB = ema21 > ema50 and close > ema50
    bool bjS = ema21 < ema50 and close < ema50
    bool pbB = ema34 > ema144 and close > ema144 and ema34 > ema34[5]
    bool pbS = ema34 < ema144 and close < ema144 and ema34 < ema34[5]
    bool smcB = ema30 > ema100 and close > ta.highest(high, 5)[1]
    bool smcS = ema30 < ema100 and close < ta.lowest(low, 5)[1]
    float swingLo = ta.lowest(low, 20)[1]
    float swingHi = ta.highest(high, 20)[1]
    bool liqB = low <= swingLo * 1.001 and close > swingLo and close > open
    bool liqS = high >= swingHi * 0.999 and close < swingHi and close < open
    float hl2v = (high + low) / 2
    float tenkan = ta.ema(hl2v, 9)
    float kijun  = ta.ema(hl2v, 26)
    float sa = ta.ema((tenkan + kijun) / 2, 26)
    float sb = ta.ema(hl2v, 52)
    float cTop = math.max(sa, sb)[26]
    float cBot = math.min(sa, sb)[26]
    bool icB = close > cTop and tenkan > kijun
    bool icS = close < cBot and tenkan < kijun
    float wSum = wBj + wLiq + wSmc + wPb + wIc
    float bullSc = (bjB ? wBj : 0) + (liqB ? wLiq : 0) + (smcB ? wSmc : 0) + (pbB ? wPb : 0) + (icB ? wIc : 0)
    float bearSc = (bjS ? wBj : 0) + (liqS ? wLiq : 0) + (smcS ? wSmc : 0) + (pbS ? wPb : 0) + (icS ? wIc : 0)
    float net = (bullSc - bearSc) / wSum
    [_, _, adxV] = ta.dmi(14, 14)
    bool adxOk = adxV >= adxF
    bool aLong  = net >= minL and adxOk
    bool aShort = -net >= minS and adxOk
    [aLong ? 1.0 : 0.0, aShort ? 1.0 : 0.0, net, adxV]

[h1Long, h1Short, h1Net, h1Adx] = request.security(syminfo.tickerid, "60",  f_trend_pack(isForex, false), barmerge.gaps_off, barmerge.lookahead_off)
[h4Long, h4Short, h4Net, h4Adx] = request.security(syminfo.tickerid, "240", f_trend_pack(isForex, true),  barmerge.gaps_off, barmerge.lookahead_off)

bool h1Bull = h1Long > 0.5
bool h1Bear = h1Short > 0.5
bool h4Bull = h4Long > 0.5
bool h4Bear = h4Short > 0.5

bool trendAllowLong = not useTrendF or (
     trendRule == "both_agree" ? (h1Bull and h4Bull) :
     trendRule == "4h_lead"    ? (h4Bull and not h4Bear) :
     (h1Bull and not h1Bear))
bool trendAllowShort = not useTrendF or (
     trendRule == "both_agree" ? (h1Bear and h4Bear) :
     trendRule == "4h_lead"    ? (h4Bear and not h4Bull) :
     (h1Bear and not h1Bull))

if block4hCh and useTrendF
    trendAllowLong  := trendAllowLong  and not h4Bear
    trendAllowShort := trendAllowShort and not h4Bull

grpUi = "UI"
showTable = input.bool(true, "Info table", group=grpUi)
showZones = input.bool(true, "Draw FTC boxes", group=grpUi)

mseS = mse.defaultMseSettings()
mseS.atr := trex.settingsForSymbol(trex.defaultSettings())

effectiveMinScore() =>
    trex.isCrypto() ? math.max(minScore, 50) : minScore

var entry.EntrySettings eS = entry.defaultEntrySettings()
eS.structureTf := stTf
eS.patternTf := patTf
eS.triggerTf := trTf
eS.slThMult := slMult
eS.tpThMult := tpMult
eS.useFtc := useFtcRtp
eS.useRtp := useFtcRtp

var sm.SmartMoneySettings smS = sm.defaultSmartMoneySettings()
smS.minConfirmations := minSm

crS = cr.defaultSettings()
crFlags = cr.patternFlags(crS)

type WatchedLevel
    int birthTime
    float pivotPrice
    float zoneTop
    float zoneBot
    float ftcTop
    float ftcBot
    float rtpTop
    float rtpBot
    bool ftcCred
    bool isHigh
    int pivotKind
    float thPips
    string srcTf
    bool ftcSpent
    bool rtpSet
    bool broken
    bool smOk
    int smCount
    bool tradedFtc
    bool tradedRtp

var array<WatchedLevel> watchLv = array.new<WatchedLevel>()

eS.minStructureScore := effectiveMinScore()

bearSpawnPack(mse.MseSettings ms, sm.SmartMoneySettings sms, string tf) =>
    int len = trex.lenForTf(tf, ms.atr)
    float boost = trex.thBoostForLen(len, ms.atr)
    [sig, zTop, zBot, price, bTime, _, _, _, ftcT, ftcB, fc, sc, kind, th] = mse.bearLevelPack(ms, len, boost, tf)
    [smOk, smCnt, _, _, _] = sm.confluencePackAtZone(zTop, zBot, true, sms)
    [sig, zTop, zBot, price, bTime, ftcT, ftcB, fc, sc, kind, th, smOk, smCnt]

bullSpawnPack(mse.MseSettings ms, sm.SmartMoneySettings sms, string tf) =>
    int len = trex.lenForTf(tf, ms.atr)
    float boost = trex.thBoostForLen(len, ms.atr)
    [sig, zTop, zBot, price, bTime, _, _, _, ftcT, ftcB, fc, sc, kind, th] = mse.bullLevelPack(ms, len, boost, tf)
    [smOk, smCnt, _, _, _] = sm.confluencePackAtZone(zTop, zBot, false, sms)
    [sig, zTop, zBot, price, bTime, ftcT, ftcB, fc, sc, kind, th, smOk, smCnt]

pushBearIfNew(bool en, string tf, int sig, int prevSig, float zTop, float zBot, float price, int bTime,
     float ftcT, float ftcB, int fc, int sc, int kind, float th, int smOk, int smCnt) =>
    if en and sig == 1 and prevSig != 1 and entry.levelEligible(sig, sc, kind, fc, eS) and smOk == 1
        array.push(watchLv, WatchedLevel.new(bTime, price, zTop, zBot, ftcT, ftcB, na, na, fc == 1, true, kind, th, tf, false, false, false, true, smCnt, false, false))

pushBullIfNew(bool en, string tf, int sig, int prevSig, float zTop, float zBot, float price, int bTime,
     float ftcT, float ftcB, int fc, int sc, int kind, float th, int smOk, int smCnt) =>
    if en and sig == 1 and prevSig != 1 and entry.levelEligible(sig, sc, kind, fc, eS) and smOk == 1
        array.push(watchLv, WatchedLevel.new(bTime, price, zTop, zBot, ftcT, ftcB, na, na, fc == 1, false, kind, th, tf, false, false, false, true, smCnt, false, false))

[mnBSig, mnBTop, mnBBot, mnBPrice, mnBTime, mnBFtcT, mnBFtcB, mnBFc, mnBSc, mnBKind, mnBTh, mnBSmOk, mnBSmCnt] =
     request.security(syminfo.tickerid, "M", bearSpawnPack(mseS, smS, "M"), barmerge.gaps_off, barmerge.lookahead_off)
[mnUSig, mnUTop, mnUBot, mnUPrice, mnUTime, mnUFtcT, mnUFtcB, mnUFc, mnUSc, mnUKind, mnUTh, mnUSmOk, mnUSmCnt] =
     request.security(syminfo.tickerid, "M", bullSpawnPack(mseS, smS, "M"), barmerge.gaps_off, barmerge.lookahead_off)

[wBSig, wBTop, wBBot, wBPrice, wBTime, wBFtcT, wBFtcB, wBFc, wBSc, wBKind, wBTh, wBSmOk, wBSmCnt] =
     request.security(syminfo.tickerid, "W", bearSpawnPack(mseS, smS, "W"), barmerge.gaps_off, barmerge.lookahead_off)
[wUSig, wUTop, wUBot, wUPrice, wUTime, wUFtcT, wUFtcB, wUFc, wUSc, wUKind, wUTh, wUSmOk, wUSmCnt] =
     request.security(syminfo.tickerid, "W", bullSpawnPack(mseS, smS, "W"), barmerge.gaps_off, barmerge.lookahead_off)

[dBSig, dBTop, dBBot, dBPrice, dBTime, dBFtcT, dBFtcB, dBFc, dBSc, dBKind, dBTh, dBSmOk, dBSmCnt] =
     request.security(syminfo.tickerid, "D", bearSpawnPack(mseS, smS, "D"), barmerge.gaps_off, barmerge.lookahead_off)
[dUSig, dUTop, dUBot, dUPrice, dUTime, dUFtcT, dUFtcB, dUFc, dUSc, dUKind, dUTh, dUSmOk, dUSmCnt] =
     request.security(syminfo.tickerid, "D", bullSpawnPack(mseS, smS, "D"), barmerge.gaps_off, barmerge.lookahead_off)

[h4BSig, h4BTop, h4BBot, h4BPrice, h4BTime, h4BFtcT, h4BFtcB, h4BFc, h4BSc, h4BKind, h4BTh, h4BSmOk, h4BSmCnt] =
     request.security(syminfo.tickerid, "240", bearSpawnPack(mseS, smS, "240"), barmerge.gaps_off, barmerge.lookahead_off)
[h4USig, h4UTop, h4UBot, h4UPrice, h4UTime, h4UFtcT, h4UFtcB, h4UFc, h4USc, h4UKind, h4UTh, h4USmOk, h4USmCnt] =
     request.security(syminfo.tickerid, "240", bullSpawnPack(mseS, smS, "240"), barmerge.gaps_off, barmerge.lookahead_off)

[h1BSig, h1BTop, h1BBot, h1BPrice, h1BTime, h1BFtcT, h1BFtcB, h1BFc, h1BSc, h1BKind, h1BTh, h1BSmOk, h1BSmCnt] =
     request.security(syminfo.tickerid, "60", bearSpawnPack(mseS, smS, "60"), barmerge.gaps_off, barmerge.lookahead_off)
[h1USig, h1UTop, h1UBot, h1UPrice, h1UTime, h1UFtcT, h1UFtcB, h1UFc, h1USc, h1UKind, h1UTh, h1USmOk, h1USmCnt] =
     request.security(syminfo.tickerid, "60", bullSpawnPack(mseS, smS, "60"), barmerge.gaps_off, barmerge.lookahead_off)

pushBearIfNew(useMn, "M", mnBSig, mnBSig[1], mnBTop, mnBBot, mnBPrice, mnBTime, mnBFtcT, mnBFtcB, mnBFc, mnBSc, mnBKind, mnBTh, mnBSmOk, mnBSmCnt)
pushBullIfNew(useMn, "M", mnUSig, mnUSig[1], mnUTop, mnUBot, mnUPrice, mnUTime, mnUFtcT, mnUFtcB, mnUFc, mnUSc, mnUKind, mnUTh, mnUSmOk, mnUSmCnt)
pushBearIfNew(useW1, "W", wBSig, wBSig[1], wBTop, wBBot, wBPrice, wBTime, wBFtcT, wBFtcB, wBFc, wBSc, wBKind, wBTh, wBSmOk, wBSmCnt)
pushBullIfNew(useW1, "W", wUSig, wUSig[1], wUTop, wUBot, wUPrice, wUTime, wUFtcT, wUFtcB, wUFc, wUSc, wUKind, wUTh, wUSmOk, wUSmCnt)
pushBearIfNew(useD1, "D", dBSig, dBSig[1], dBTop, dBBot, dBPrice, dBTime, dBFtcT, dBFtcB, dBFc, dBSc, dBKind, dBTh, dBSmOk, dBSmCnt)
pushBullIfNew(useD1, "D", dUSig, dUSig[1], dUTop, dUBot, dUPrice, dUTime, dUFtcT, dUFtcB, dUFc, dUSc, dUKind, dUTh, dUSmOk, dUSmCnt)
pushBearIfNew(useH4, "240", h4BSig, h4BSig[1], h4BTop, h4BBot, h4BPrice, h4BTime, h4BFtcT, h4BFtcB, h4BFc, h4BSc, h4BKind, h4BTh, h4BSmOk, h4BSmCnt)
pushBullIfNew(useH4, "240", h4USig, h4USig[1], h4UTop, h4UBot, h4UPrice, h4UTime, h4UFtcT, h4UFtcB, h4UFc, h4USc, h4UKind, h4UTh, h4USmOk, h4USmCnt)
pushBearIfNew(useH1, "60", h1BSig, h1BSig[1], h1BTop, h1BBot, h1BPrice, h1BTime, h1BFtcT, h1BFtcB, h1BFc, h1BSc, h1BKind, h1BTh, h1BSmOk, h1BSmCnt)
pushBullIfNew(useH1, "60", h1USig, h1USig[1], h1UTop, h1UBot, h1UPrice, h1UTime, h1UFtcT, h1UFtcB, h1UFc, h1USc, h1UKind, h1UTh, h1USmOk, h1USmCnt)

bullPattern() => cr.anyBullishPattern(crFlags)
bearPattern() => cr.anyBearishPattern(crFlags)

patternLabel(bool bullish) =>
    int pid = bullish ? cr.firstBullishPattern(crFlags) : cr.firstBearishPattern(crFlags)
    pid >= 0 ? cr.patternDisplayName(pid, patFa) : "PAT"

inStructZone(WatchedLevel lv) =>
    entry.priceInZone(high, low, lv.zoneTop, lv.zoneBot) or entry.priceInZone(high, low, lv.ftcTop, lv.ftcBot) or (lv.rtpSet and entry.priceInZone(high, low, lv.rtpTop, lv.rtpBot))

bool signalLong = false
bool signalShort = false
string sigNote = ""
int sigIdx = -1

if barstate.isconfirmed and array.size(watchLv) > 0
    for i = 0 to array.size(watchLv) - 1
        WatchedLevel lv = array.get(watchLv, i)
        if lv.broken or (lv.tradedFtc or lv.tradedRtp) or not lv.smOk
            continue
        int ent = entry.scanEntry(lv.isHigh, high, low, high[1], low[1], lv.ftcTop, lv.ftcBot, lv.rtpTop, lv.rtpBot, lv.ftcCred, lv.pivotKind, lv.broken, lv.ftcSpent, lv.rtpSet, lv.tradedFtc, lv.tradedRtp, eS)
        bool ftcRtpOk = useFtcRtp and ent != entry.ENTRY_NONE and not lv.isHigh
        bool ftcRtpShort = useFtcRtp and ent != entry.ENTRY_NONE and lv.isHigh
        bool patLong = useCandle and not lv.isHigh and bullPattern() and inStructZone(lv)
        bool patShort = useCandle and lv.isHigh and bearPattern() and inStructZone(lv)
        if (ftcRtpOk or patLong) and trendAllowLong
            signalLong := true
            sigNote := ftcRtpOk ? entry.entryKindName(ent) : patternLabel(true)
            sigIdx := i
            lv.tradedFtc := ent == entry.ENTRY_FTC ? true : lv.tradedFtc
            lv.tradedRtp := ent == entry.ENTRY_RTP ? true : lv.tradedRtp
            if patLong and ent == entry.ENTRY_NONE
                lv.tradedFtc := true
        if (ftcRtpShort or patShort) and trendAllowShort
            signalShort := true
            sigNote := ftcRtpShort ? entry.entryKindName(ent) : patternLabel(false)
            sigIdx := i
            lv.tradedFtc := ent == entry.ENTRY_FTC ? true : lv.tradedFtc
            lv.tradedRtp := ent == entry.ENTRY_RTP ? true : lv.tradedRtp
            if patShort and ent == entry.ENTRY_NONE
                lv.tradedFtc := true
        bool newFtc = not lv.ftcSpent and entry.priceInZone(high, low, lv.ftcTop, lv.ftcBot) and not entry.priceInZone(high[1], low[1], lv.ftcTop, lv.ftcBot)
        if newFtc
            lv.ftcSpent := true
            if not lv.rtpSet
                [rT, rB] = entry.rtpFromBar(lv.isHigh, open, high, low, close)
                lv.rtpTop := rT
                lv.rtpBot := rB
                lv.rtpSet := true
        if entry.priceBreakZone(lv.isHigh, close, lv.zoneTop, lv.zoneBot)
            lv.broken := true
        array.set(watchLv, i, lv)

if barstate.isconfirmed and sigIdx >= 0
    WatchedLevel lv = array.get(watchLv, sigIdx)
    if signalLong and strategy.position_size == 0 and trendAllowLong
        [sl, tp] = entry.entrySlTp(false, lv.zoneTop, lv.zoneBot, lv.pivotPrice, lv.thPips, eS)
        strategy.entry("L", strategy.long, comment=sigNote + " " + trex.tfLabel(lv.srcTf))
        strategy.exit("XL", "L", stop=sl, limit=tp)
        label.new(bar_index, low, "BUY\n" + sigNote, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
    if signalShort and strategy.position_size == 0 and trendAllowShort
        [sl, tp] = entry.entrySlTp(true, lv.zoneTop, lv.zoneBot, lv.pivotPrice, lv.thPips, eS)
        strategy.entry("S", strategy.short, comment=sigNote + " " + trex.tfLabel(lv.srcTf))
        strategy.exit("XS", "S", stop=sl, limit=tp)
        label.new(bar_index, high, "SELL\n" + sigNote, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

while array.size(watchLv) > 40
    array.shift(watchLv)

if showZones and barstate.islast
    for i = 0 to array.size(watchLv) - 1
        WatchedLevel lv = array.get(watchLv, i)
        if not lv.broken and not lv.tradedFtc and lv.ftcTop > lv.ftcBot
            box.new(lv.birthTime, lv.ftcTop, time, lv.ftcBot, xloc=xloc.bar_time, bgcolor=color.new(mse.ftcColor(), 92), border_color=color.new(mse.ftcColor(), 50))

var table info = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 80), border_width=1)
if showTable and barstate.islast
    table.cell(info, 0, 0, "Monster", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 0, "Trex Vol", text_color=color.lime, text_size=size.small)
    table.cell(info, 0, 1, "Pair", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 1, pairMode, text_color=color.white, text_size=size.small)
    table.cell(info, 0, 2, "Trigger", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 2, trex.tfLabel(trTf), text_color=color.white, text_size=size.small)
    table.cell(info, 0, 3, "1h Trend", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 3, h1Bull ? "BULL" : h1Bear ? "BEAR" : "—", text_color=h1Bull ? color.lime : h1Bear ? color.red : color.gray, text_size=size.small)
    table.cell(info, 0, 4, "4h Trend", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 4, h4Bull ? "BULL" : h4Bear ? "BEAR" : "—", text_color=h4Bull ? color.lime : h4Bear ? color.red : color.gray, text_size=size.small)
    table.cell(info, 0, 5, "Trend Gate", text_color=color.gray, text_size=size.small)
    string gateTxt = not useTrendF ? "OFF" : trendAllowLong ? "LONG OK" : trendAllowShort ? "SHORT OK" : "BLOCKED"
    color gateCol = not useTrendF ? color.gray : trendAllowLong or trendAllowShort ? color.lime : color.orange
    table.cell(info, 1, 5, gateTxt, text_color=gateCol, text_size=size.small)
    table.cell(info, 0, 6, "SM", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 6, str.tostring(minSm) + "/3 HTF", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 7, "In level", text_color=color.gray, text_size=size.small)
    bool inLvl = false
    if array.size(watchLv) > 0
        for i = 0 to array.size(watchLv) - 1
            WatchedLevel lv = array.get(watchLv, i)
            if not lv.broken and entry.priceInZone(high, low, lv.zoneTop, lv.zoneBot)
                inLvl := true
    table.cell(info, 1, 7, inLvl ? "YES" : "no", text_color=inLvl ? color.lime : color.gray, text_size=size.small)
    table.cell(info, 0, 8, "Active Lv", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 8, str.tostring(array.size(watchLv)), text_color=color.white, text_size=size.small)

bgcolor(useTrendF and not trendAllowLong and not trendAllowShort ? color.new(color.orange, 92) : na)
