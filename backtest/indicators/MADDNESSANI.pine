// © MADDNESSANI v3 — wider structural SL + structural TP + BE/trail

//@version=6
strategy("MADDNESSANI", shorttitle="MADDNESSANI", overlay=true, max_labels_count=200,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.1,
     pyramiding=0, calc_on_every_tick=false, process_orders_on_close=true)

// ═══════════════════════════════════════════════════════════════════
// MADDNESSANI v3 — fixes weak TP + early pullback stop-outs
// • Wider SL: swing + EMA34 + liquidity level + ATR buffer
// • Structural TP: next swing liquidity with minimum R:R floor
// • Breakeven after 1R, ATR trail after 1.5R
// ═══════════════════════════════════════════════════════════════════

string GRP_MODE  = "⚙ Mode"
string GRP_CORE  = "🎯 Core Signals"
string GRP_ZONE  = "📦 Zone Confluence"
string GRP_TECH  = "📈 Technical Filters"
string GRP_HTF   = "🕐 Higher Timeframe"
string GRP_RISK  = "🛡 Risk Management"
string GRP_EXIT  = "🎯 Exit Engine"
string GRP_VIS   = "👁 Display"

string modeIn = input.string("precision", "Strategy Mode",
     options=["precision", "balanced", "sniper"],
     tooltip="precision=WR focus | balanced=more trades | sniper=ultra strict",
     group=GRP_MODE)

int    effMinTier1 = modeIn == "sniper" ? 2 : modeIn == "precision" ? 2 : 1
int    effTechNeed = modeIn == "sniper" ? 4 : modeIn == "precision" ? 4 : 2
float  effMinScore = modeIn == "sniper" ? 9.0 : modeIn == "precision" ? 7.5 : 5.5
int    effMinZone  = modeIn == "sniper" ? 2 : modeIn == "precision" ? 2 : 1
int    effCooldown = modeIn == "sniper" ? 10 : modeIn == "precision" ? 5 : 3
float  effMinRR    = modeIn == "sniper" ? 2.5 : modeIn == "precision" ? 2.0 : 1.8

int    zoneLB    = input.int(8, "Zone Lookback (bars)", minval=3, maxval=20, group=GRP_ZONE)
bool   useRSI    = input.bool(true,  "RSI Advanced", group=GRP_CORE)
bool   useLiq    = input.bool(true,  "Liquidity Shift", group=GRP_CORE)
bool   usePullback=input.bool(true,  "Strong Pullback", group=GRP_CORE)
bool   useFVG    = input.bool(true,  "FVG Zone", group=GRP_ZONE)
bool   useSD     = input.bool(true,  "S/D Retest", group=GRP_ZONE)

bool   useUT     = input.bool(true,  "UT Bot Trend", group=GRP_TECH)
bool   useAlpha  = input.bool(true,  "AlphaTrend", group=GRP_TECH)
bool   useZL     = input.bool(true,  "Zero-Lag Trend", group=GRP_TECH)
bool   useBJ     = input.bool(true,  "Bj EMA 21/50", group=GRP_TECH)
bool   useADX    = input.bool(true,  "ADX Trend Filter", group=GRP_TECH)
float  adxMin    = input.float(22.0, "Min ADX", step=1.0, group=GRP_TECH)

bool   useHTF    = input.bool(true,  "HTF Trend Filter", group=GRP_HTF)
string htfTF     = input.timeframe("240", "HTF Timeframe", group=GRP_HTF)

int    rsiLen    = input.int(14, "RSI Length", group=GRP_CORE)
int    pivLen    = input.int(5,  "Liquidity Pivot", minval=2, group=GRP_CORE)
int    sdLen     = input.int(10, "S/D Pivot", minval=3, group=GRP_ZONE)
float  utMult    = input.float(1.0, "UT ATR Mult", step=0.1, group=GRP_TECH)

int    swingLen  = input.int(12, "Swing Lookback", minval=5, maxval=40, group=GRP_RISK,
     tooltip="Wider = SL survives normal pullbacks on 1h")
float  slAtrBuf  = input.float(1.5, "SL ATR Buffer", step=0.1, minval=0.5, group=GRP_RISK)
float  minRiskAtr= input.float(0.55, "Min Risk (ATR)", step=0.05, group=GRP_RISK)
bool   useEmaSL  = input.bool(true, "Include EMA34 in SL", group=GRP_RISK)

string tpMode    = input.string("hybrid", "TP Mode",
     options=["hybrid", "structural", "fixed_rr"],
     tooltip="hybrid=max(struct swing, min R:R) | structural=swing liquidity | fixed_rr=R:R only",
     group=GRP_EXIT)
float  minRR     = input.float(2.0, "Min Take-Profit R:R", step=0.1, minval=1.0, maxval=5.0, group=GRP_EXIT)
float  maxRR     = input.float(4.0, "Max Take-Profit R:R (cap)", step=0.1, minval=1.5, maxval=8.0, group=GRP_EXIT)
int    tpSwingLB = input.int(24, "TP Swing Lookback", minval=8, maxval=60, group=GRP_EXIT)
bool   useBE     = input.bool(true,  "Breakeven after 1R", group=GRP_EXIT)
float  beTrigger = input.float(1.0, "BE Trigger (R)", step=0.1, minval=0.5, group=GRP_EXIT)
bool   useTrail  = input.bool(true,  "Trail after 1.5R", group=GRP_EXIT)
float  trailTrig = input.float(1.5, "Trail Trigger (R)", step=0.1, minval=1.0, group=GRP_EXIT)
float  trailAtr  = input.float(1.3, "Trail ATR Mult", step=0.1, group=GRP_EXIT)

bool   showDash  = input.bool(true, "Dashboard", group=GRP_VIS)
bool   showMA    = input.bool(true, "EMA 21/50", group=GRP_VIS)
bool   showLvls  = input.bool(true, "Show SL/TP Lines", group=GRP_VIS)

float effRRfloor = math.max(minRR, effMinRR)
float atr14 = ta.atr(14)

// ── ADX ───────────────────────────────────────────────────────────
[diPlus, diMinus, adxV] = ta.dmi(14, 14)
bool adxOK = not useADX or adxV >= adxMin

// ── HTF trend ─────────────────────────────────────────────────────
htfClose = request.security(syminfo.tickerid, htfTF, close[1], barmerge.gaps_off, barmerge.lookahead_off)
htfEma50 = request.security(syminfo.tickerid, htfTF, ta.ema(close, 50)[1], barmerge.gaps_off, barmerge.lookahead_off)
htfBull  = not useHTF or htfClose > htfEma50
htfBear  = not useHTF or htfClose < htfEma50

// ── RSI Advanced ──────────────────────────────────────────────────
float rsiV = ta.rsi(close, rsiLen)
float ewo  = ta.sma(hl2, 5) - ta.sma(hl2, 34)
float mfiV = ta.mfi(hlc3, 14)
float volMA = ta.sma(volume, 20)
bool volOK = volume > volMA * 0.8
float breakLv = ta.highest(high, 10)[1]
var bool inOS = false
if rsiV < 30
    inOS := true
bool rsiLong  = useRSI and rsiV[1] < 40 and rsiV >= 40 and mfiV > 30 and ewo > ewo[1] and volOK and (close > breakLv or inOS)
bool rsiShort = useRSI and rsiV[1] > 60 and rsiV <= 60 and mfiV < 70 and ewo < ewo[1] and volOK
if rsiLong
    inOS := false

// ── Liquidity Shift ───────────────────────────────────────────────
float ph = ta.pivothigh(high, pivLen, pivLen)
float pl = ta.pivotlow(low, pivLen, pivLen)
var float mSwingHi = na
var float mSwingLo = na
var bool  bullPend = false
var bool  bearPend = false
var float bullLvl  = na
var float bearLvl  = na
if not na(ph)
    mSwingHi := ph
if not na(pl)
    mSwingLo := pl
if useLiq and not na(mSwingLo) and low < mSwingLo and close > mSwingLo
    bullPend := true
    bullLvl  := mSwingLo
if useLiq and not na(mSwingHi) and high > mSwingHi and close < mSwingHi
    bearPend := true
    bearLvl  := mSwingHi
bool liqLong  = useLiq and bullPend and close > mSwingHi
bool liqShort = useLiq and bearPend and close < mSwingLo
if liqLong
    bullPend := false
if liqShort
    bearPend := false

// ── Strong Pullback ───────────────────────────────────────────────
float emaF = ta.ema(close, 34)
float emaS = ta.ema(close, 144)
bool trendUp = emaF > emaS and close > emaS
bool trendDn = emaF < emaS and close < emaS
bool brokeUp = close > ta.highest(high, 20)[1] and close > open
bool brokeDn = close < ta.lowest(low, 20)[1] and close < open
bool retestL = low <= emaF and close > emaF
bool retestS = high >= emaF and close < emaF
bool spLong  = usePullback and trendUp and (brokeUp or retestL)
bool spShort = usePullback and trendDn and (brokeDn or retestS)

// ── Zones ─────────────────────────────────────────────────────────
bool fvgLong  = useFVG and low > high[2] and close > open
bool fvgShort = useFVG and high < low[2] and close < open
float sdBot = ta.lowest(low, sdLen)[1]
float sdTop = ta.highest(high, sdLen)[1]
bool sdLong  = useSD and low <= sdBot * 1.002 and close > sdBot and close > open
bool sdShort = useSD and high >= sdTop * 0.998 and close < sdTop and close < open

f_zone_long(int lb) =>
    int s = 0
    for i = 0 to lb - 1
        if fvgLong[i] or sdLong[i] or liqLong[i]
            s += 1
    s

f_zone_short(int lb) =>
    int s = 0
    for i = 0 to lb - 1
        if fvgShort[i] or sdShort[i] or liqShort[i]
            s += 1
    s

// ── UT Bot ────────────────────────────────────────────────────────
float utAtr = ta.atr(10) * utMult
var float tsl = na
tsl := close > nz(tsl[1], close - utAtr) and close[1] > nz(tsl[1], close - utAtr) ?
     math.max(nz(tsl[1]), close - utAtr) :
     close < nz(tsl[1], close + utAtr) and close[1] >= nz(tsl[1], close + utAtr) ?
     math.min(nz(tsl[1]), close + utAtr) :
     close > nz(tsl[1], close - utAtr) ? close - utAtr : close + utAtr
bool utBull = not useUT or close > tsl
bool utBear = not useUT or close < tsl

// ── AlphaTrend ────────────────────────────────────────────────────
float atrP = ta.sma(ta.tr, 14)
var float alphaTrend = na
bool bullM = ta.mfi(close, 14) >= 50
float upT = low - atrP
float dnT = high + atrP
alphaTrend := bullM ?
     (nz(alphaTrend[1]) < upT ? upT : math.max(nz(alphaTrend[1]), upT)) :
     (nz(alphaTrend[1]) > dnT ? dnT : math.min(nz(alphaTrend[1]), dnT))
bool alphaBull = not useAlpha or close > alphaTrend
bool alphaBear = not useAlpha or close < alphaTrend

// ── Zero-Lag ──────────────────────────────────────────────────────
int zlLen = 70
float zlMult = 1.2
int lag = (zlLen - 1) / 2
float zlema = ta.ema(close + (close - close[lag]), zlLen)
float zlAtr = ta.ema(ta.tr, zlLen)
float zlVol = ta.highest(zlAtr, zlLen * 3) * zlMult
var int zlTrend = 0
if close > zlema + zlVol and close[1] <= zlema[1] + zlVol[1]
    zlTrend := 1
if close < zlema - zlVol and close[1] >= zlema[1] - zlVol[1]
    zlTrend := -1
bool zlBull = not useZL or zlTrend == 1
bool zlBear = not useZL or zlTrend == -1

// ── Bj Bot ────────────────────────────────────────────────────────
float ma21 = ta.ema(close, 21)
float ma50 = ta.ema(close, 50)
bool bjBull = not useBJ or ma21 > ma50
bool bjBear = not useBJ or ma21 < ma50
bool bjCrossL = ta.crossover(ma21, ma50)
bool bjCrossS = ta.crossunder(ma21, ma50)

int techLong  = (utBull ? 1 : 0) + (alphaBull ? 1 : 0) + (zlBull ? 1 : 0) + (bjBull ? 1 : 0)
int techShort = (utBear ? 1 : 0) + (alphaBear ? 1 : 0) + (zlBear ? 1 : 0) + (bjBear ? 1 : 0)

int tier1L = (rsiLong ? 1 : 0) + (liqLong ? 1 : 0) + (spLong ? 1 : 0) + (bjCrossL ? 1 : 0)
int tier1S = (rsiShort ? 1 : 0) + (liqShort ? 1 : 0) + (spShort ? 1 : 0) + (bjCrossS ? 1 : 0)
float zoneL = f_zone_long(zoneLB) * 1.5
float zoneS = f_zone_short(zoneLB) * 1.5
float scoreL = zoneL + tier1L * 3.0 + techLong * 0.75
float scoreS = zoneS + tier1S * 3.0 + techShort * 0.75

var int lastSigBar = -999
bool coolOK = bar_index - lastSigBar >= effCooldown

bool rawLong  = tier1L >= effMinTier1 and zoneL >= effMinZone and scoreL >= effMinScore and
     techLong >= effTechNeed and adxOK and htfBull and coolOK and barstate.isconfirmed
bool rawShort = tier1S >= effMinTier1 and zoneS >= effMinZone and scoreS >= effMinScore and
     techShort >= effTechNeed and adxOK and htfBear and coolOK and barstate.isconfirmed

if rawLong or rawShort
    lastSigBar := bar_index

// ── SL / TP helpers ───────────────────────────────────────────────
f_long_sl(float px) =>
    float swingLo = ta.lowest(low, swingLen)
    float emaSl   = useEmaSL ? emaF - atr14 * 0.3 : swingLo
    float liqSl   = nz(bullLvl, swingLo)
    float base    = math.min(swingLo, emaSl, liqSl)
    float sl      = base - atr14 * slAtrBuf
    float risk    = math.max(px - sl, atr14 * minRiskAtr)
    [sl, risk]

f_short_sl(float px) =>
    float swingHi = ta.highest(high, swingLen)
    float emaSl   = useEmaSL ? emaF + atr14 * 0.3 : swingHi
    float liqSl   = nz(bearLvl, swingHi)
    float base    = math.max(swingHi, emaSl, liqSl)
    float sl      = base + atr14 * slAtrBuf
    float risk    = math.max(sl - px, atr14 * minRiskAtr)
    [sl, risk]

f_long_tp(float px, float risk) =>
    float rrTp      = px + risk * effRRfloor
    float structHi  = ta.highest(high, tpSwingLB)
    float structTp  = structHi + atr14 * 0.1
    float hybridTp  = math.max(rrTp, structTp)
    float capped    = px + risk * maxRR
    float tp = tpMode == "fixed_rr" ? rrTp :
         tpMode == "structural" ? math.max(structTp, px + risk * 1.2) :
         math.min(hybridTp, capped)
    tp

f_short_tp(float px, float risk) =>
    float rrTp      = px - risk * effRRfloor
    float structLo  = ta.lowest(low, tpSwingLB)
    float structTp  = structLo - atr14 * 0.1
    float hybridTp  = math.min(rrTp, structTp)
    float capped    = px - risk * maxRR
    float tp = tpMode == "fixed_rr" ? rrTp :
         tpMode == "structural" ? math.min(structTp, px - risk * 1.2) :
         math.max(hybridTp, capped)
    tp

// ── Position state for BE / trail ─────────────────────────────────
var float posEntry = na
var float posInitSL = na
var float posInitTP = na
var float posRisk = na
var bool  beActive = false
var int   posDir = 0

[calcLongSL, calcLongRisk] = f_long_sl(close)
[calcShortSL, calcShortRisk] = f_short_sl(close)
float calcLongTP  = f_long_tp(close, calcLongRisk)
float calcShortTP = f_short_tp(close, calcShortRisk)

if rawLong and strategy.position_size <= 0
    posEntry := close
    posInitSL := calcLongSL
    posInitTP := calcLongTP
    posRisk := calcLongRisk
    beActive := false
    posDir := 1
    strategy.entry("MAD Long", strategy.long, comment="MADDNESSANI L")

if rawShort and strategy.position_size >= 0
    posEntry := close
    posInitSL := calcShortSL
    posInitTP := calcShortTP
    posRisk := calcShortRisk
    beActive := false
    posDir := -1
    strategy.entry("MAD Short", strategy.short, comment="MADDNESSANI S")

if strategy.position_size == 0
    posDir := 0
    beActive := false
    posEntry := na
    posInitSL := na
    posInitTP := na
    posRisk := na

float activeSL = posInitSL
float activeTP = posInitTP

if strategy.position_size > 0 and posDir == 1 and not na(posEntry)
    if useBE and not beActive and high >= posEntry + posRisk * beTrigger
        beActive := true
    activeSL := posInitSL
    if beActive
        activeSL := math.max(activeSL, posEntry + atr14 * 0.08)
    if useTrail and beActive and high >= posEntry + posRisk * trailTrig
        float trailSl = close - atr14 * trailAtr
        activeSL := math.max(activeSL, trailSl)
    strategy.exit("MAD Long Exit", "MAD Long", stop=activeSL, limit=activeTP)

if strategy.position_size < 0 and posDir == -1 and not na(posEntry)
    if useBE and not beActive and low <= posEntry - posRisk * beTrigger
        beActive := true
    activeSL := posInitSL
    if beActive
        activeSL := math.min(activeSL, posEntry - atr14 * 0.08)
    if useTrail and beActive and low <= posEntry - posRisk * trailTrig
        float trailSl = close + atr14 * trailAtr
        activeSL := math.min(activeSL, trailSl)
    strategy.exit("MAD Short Exit", "MAD Short", stop=activeSL, limit=activeTP)

alertcondition(rawLong,  title="MADDNESSANI Long",  message='{"strategy":"MADDNESSANI","side":"long"}')
alertcondition(rawShort, title="MADDNESSANI Short", message='{"strategy":"MADDNESSANI","side":"short"}')

plot(showMA ? ma21 : na, "EMA21", color=color.blue)
plot(showMA ? ma50 : na, "EMA50", color=color.orange)
plotshape(rawLong,  "Long",  shape.triangleup,   location.belowbar, color.new(#00ff88,0), size=size.small, text="MAD")
plotshape(rawShort, "Short", shape.triangledown, location.abovebar, color.new(#ff3366,0), size=size.small, text="MAD")

plot(showLvls and strategy.position_size > 0 ? activeSL : na, "Active SL", color=color.new(color.red, 30), style=plot.style_linebr, linewidth=2)
plot(showLvls and strategy.position_size > 0 ? activeTP : na, "Active TP", color=color.new(color.lime, 30), style=plot.style_linebr, linewidth=2)
plot(showLvls and strategy.position_size > 0 ? posEntry : na, "Entry", color=color.new(color.yellow, 40), style=plot.style_linebr, linewidth=1)

var table dash = table.new(position.top_right, 2, 8, bgcolor=color.new(#0d1117,10))
if showDash and barstate.islast
    table.cell(dash, 0, 0, "MADDNESSANI", text_color=#00ff88, text_size=size.normal)
    table.cell(dash, 1, 0, "v3 " + modeIn, text_color=color.yellow, text_size=size.small)
    table.cell(dash, 0, 1, "Tier1", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(tier1L)+"/"+str.tostring(effMinTier1)+"  "+str.tostring(tier1S)+"/"+str.tostring(effMinTier1), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 2, "Tech", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(techLong)+"/"+str.tostring(effTechNeed)+"  "+str.tostring(techShort)+"/"+str.tostring(effTechNeed), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 3, "Score", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(scoreL,"#.#")+" / "+str.tostring(scoreS,"#.#"), text_color=color.yellow, text_size=size.small)
    table.cell(dash, 0, 4, "HTF / ADX", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, (htfBull ? "BULL" : "BEAR") + "  " + str.tostring(adxV,"#.#"), text_color=htfBull?color.lime:color.red, text_size=size.small)
    table.cell(dash, 0, 5, "Min R:R", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(effRRfloor,"#.#"), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 6, "Risk ATR", text_color=color.white, text_size=size.small)
    float liveRisk = strategy.position_size > 0 ? (posEntry - posInitSL) / atr14 :
         strategy.position_size < 0 ? (posInitSL - posEntry) / atr14 : calcLongRisk / atr14
    table.cell(dash, 1, 6, str.tostring(liveRisk,"#.#") + " ATR", text_color=color.orange, text_size=size.small)
    table.cell(dash, 0, 7, "BE / Trail", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 7, (beActive ? "BE ON" : "—") + " / " + (useTrail ? "ON" : "OFF"), text_color=beActive?color.lime:color.gray, text_size=size.small)
