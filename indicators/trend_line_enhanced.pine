//@version=5
indicator("Trendline MTF Signals [farhad]", shorttitle="TL Signals", overlay=true, max_bars_back=500, max_lines_count=500, max_labels_count=500)

// ─── تایم‌فریم‌های فعال ──────────────────────────────────────────────────────
string TF5  = "5"
string TF15 = "15"
string TF60 = "60"

isAllowedTF(string tf) =>
    tf == TF5 or tf == TF15 or tf == TF60

chartTFKey() =>
    string tf = timeframe.period
    isAllowedTF(tf) ? tf : na

getPreset(string tf) =>
    switch tf
        TF5  => [8,  0.40, 0.25, 0.025, 1.20]
        TF15 => [10, 0.50, 0.30, 0.020, 1.50]
        TF60 => [15, 0.40, 0.25, 0.015, 1.30]
        => [10, 0.50, 0.30, 0.020, 1.50]

tfLabel(string tf) =>
    switch tf
        TF5  => "5m"
        TF15 => "15m"
        TF60 => "1H"
        => tf

tfColor(string tf) =>
    switch tf
        TF5  => color.new(#2196F3, 0)
        TF15 => color.new(#00BCD4, 0)
        TF60 => color.new(#FF9800, 0)
        => color.gray

tfResColor(string tf) => color.new(tfColor(tf), 20)
tfSupColor(string tf) => color.new(tfColor(tf), 0)

ExtenSwitcher(ex) =>
    switch ex
        "  25" => 1
        "  50" => 2
        "  75" => 3
        => 0

// ─── Inputs ───────────────────────────────────────────────────────────────────
string CORE    = "➞ Core 🔸"
string MTF     = "➞ Timeframes 🔸"
string FILTER  = "➞ Accuracy Filters 🔸"
string SIGNALS = "➞ Signals 🔸"

bool useAutoPreset  = input.bool(true, "تنظیم خودکار پیشنهادی", group=CORE)
bool Trendtype      = input.string("Wicks", "نوع پیوت", options=["Wicks", "Body"], group=CORE) == "Wicks"
string Extensions   = input.string("Dynamic", "امتداد خط", options=["  25", "  50", "  75", "Dynamic"], group=CORE)
bool showTFTable    = input.bool(true, "جدول وضعیت", group=CORE)
int  historyDays    = input.int(7, "نمایش سیگنال و خط (روز)", minval=1, maxval=30, group=CORE)

bool show5m  = input.bool(true, "5 دقیقه",  group=MTF, inline="t1")
bool show15m = input.bool(true, "15 دقیقه", group=MTF, inline="t1")
bool show1h  = input.bool(true, "1 ساعت",   group=MTF, inline="t2")

bool useStructural     = input.bool(true, "فیلتر ساختار HL/LH", group=FILTER)
bool usePathValidation = input.bool(true, "اعتبارسنجی مسیر", group=FILTER)
bool useMinSwing       = input.bool(true, "حداقل سوینگ", group=FILTER)
bool useSlopeFilter    = input.bool(true, "فیلتر زاویه", group=FILTER)
bool useProminence     = input.bool(true, "برجستگی پیوت", group=FILTER)
bool useTouchScore     = input.bool(false, "امتیاز برخورد", group=FILTER)
int  minTouchCount     = input.int(0, "حداقل برخورد", minval=0, maxval=5, group=FILTER)

bool enableSignals   = input.bool(true, "فعال‌سازی سیگنال", group=SIGNALS)
bool useDoji         = input.bool(true, "دوجی", group=SIGNALS, inline="pat")
bool usePinBar       = input.bool(true, "پین‌بار", group=SIGNALS, inline="pat")
float dojiBodyRatio  = input.float(0.15, "نسبت بدنه دوجی", minval=0.05, maxval=0.35, step=0.01, group=SIGNALS)
float pinWickRatio   = input.float(0.60, "نسبت سایه پین‌بار", minval=0.40, maxval=0.80, step=0.05, group=SIGNALS)
float pinBodyMax     = input.float(0.30, "حداکثر بدنه پین‌بار", minval=0.10, maxval=0.45, step=0.05, group=SIGNALS)
float touchTolATR    = input.float(0.35, "تحمل برخورد (× ATR)", minval=0.1, maxval=1.5, step=0.05, group=SIGNALS)
bool showSignalLabel = input.bool(true, "برچسب TF روی سیگنال", group=SIGNALS)

int   manualPeriod           = input.int(10, "Period دستی", minval=2, maxval=50, group=CORE)
float manualMinSwingATR      = input.float(0.5, "minSwing دستی", minval=0.1, maxval=5.0, step=0.1, group=FILTER)
float manualMinProminenceATR = input.float(0.3, "minProminence دستی", minval=0.0, maxval=3.0, step=0.1, group=FILTER)
float manualMinSlopeATR      = input.float(0.02, "minSlope دستی", minval=0.0, maxval=1.0, step=0.01, group=FILTER)
float manualMaxSlopeATR      = input.float(1.5, "maxSlope دستی", minval=0.1, maxval=5.0, step=0.1, group=FILTER)

int historyMs = historyDays * 24 * 60 * 60 * 1000
bool inHistory = time >= timenow - historyMs

// ─── فیلترها ─────────────────────────────────────────────────────────────────
passesStructural(bool enabled, float pPrev, float pCurr, bool isSupport) =>
    not enabled or (isSupport ? pCurr >= pPrev : pCurr <= pPrev)

passesMinSwing(bool enabled, float pPrev, float pCurr, float atr, float mult) =>
    not enabled or math.abs(pCurr - pPrev) >= atr * mult

passesSlope(bool enabled, float slope, int barTime, float atr, float minMult, float maxMult) =>
    if not enabled
        true
    else
        slopePerBar = math.abs(slope * barTime)
        slopePerBar >= atr * minMult and slopePerBar <= atr * maxMult

passesProminence(bool enabled, float pivotVal, bool isHigh, int period, float atr, float mult) =>
    if not enabled
        true
    else
        prominence = isHigh ? pivotVal - ta.lowest(low, period * 2) : ta.highest(high, period * 2) - pivotVal
        prominence >= atr * mult

validatePath(bool enabled, int t1, float p1, int t2, float slope, bool isSupport, float zband) =>
    if not enabled or t1 == t2
        true
    else
        bool ok = true
        int tMin = math.min(t1, t2)
        int tMax = math.max(t1, t2)
        int maxLook = math.min(300, bar_index)
        for i = 0 to maxLook
            int ti = time[i]
            if ti >= tMin and ti <= tMax
                float lp = p1 + (ti - t1) * slope
                if isSupport and low[i] < lp - zband
                    ok := false
                if not isSupport and high[i] > lp + zband
                    ok := false
        ok

countTouches(bool enabled, int t1, float p1, float slope, bool isSupport, int fromT, float zband, int minTouch) =>
    if not enabled
        minTouch
    else
        int touches = 0
        int maxLook = math.min(200, bar_index)
        for i = 0 to maxLook
            if time[i] < fromT
                break
            float lp = p1 + (time[i] - t1) * slope
            bool hit = isSupport ? math.abs(low[i] - lp) <= zband * 1.5 : math.abs(high[i] - lp) <= zband * 1.5
            if hit
                touches += 1
        touches

// ─── موتور تشخیص ─────────────────────────────────────────────────────────────
f_detect(bool useWicks, int period, float minSwingAtr, float minPromAtr, float minSlopeAtr, float maxSlopeAtr, bool structF, bool pathF, bool minSwingF, bool slopeF, bool promF, bool touchF, int minTouch) =>
    int barTime = time - time[1]
    float atr14 = ta.atr(14)
    float zband = math.min(ta.atr(30) * 0.3, close * 0.003) / 2.0

    float phSrc = useWicks ? high : (close > open ? close : open)
    float plSrc = useWicks ? low  : (close > open ? open  : close)
    int rightBars = math.max(1, int(math.round(period / 2.0)))
    float ph = ta.pivothigh(phSrc, period, rightBars)
    float pl = ta.pivotlow(plSrc, period, rightBars)

    var float prevPH = na
    var float prevPL = na
    var int   prevPHT = na
    var int   prevPLT = na

    var int   resT1 = na
    var float resP1 = na
    var int   resT2 = na
    var float resP2 = na
    var float resSlope = na
    var bool  resValid = false

    var int   supT1 = na
    var float supP1 = na
    var int   supT2 = na
    var float supP2 = na
    var float supSlope = na
    var bool  supValid = false

    if not na(ph)
        int phTime = time[rightBars]
        if not na(prevPH) and prevPHT != phTime
            float slope = (ph - prevPH) / (phTime - prevPHT)
            bool ok = passesStructural(structF, prevPH, ph, false)
            ok := ok and passesMinSwing(minSwingF, prevPH, ph, atr14, minSwingAtr)
            ok := ok and passesSlope(slopeF, slope, barTime, atr14, minSlopeAtr, maxSlopeAtr)
            ok := ok and passesProminence(promF, ph, true, period, atr14, minPromAtr)
            ok := ok and validatePath(pathF, prevPHT, prevPH, phTime, slope, false, zband)
            int touches = countTouches(touchF, prevPHT, prevPH, slope, false, phTime, zband, minTouch)
            ok := ok and (not touchF or touches >= minTouch)
            if ok
                resT1 := prevPHT
                resP1 := prevPH
                resT2 := phTime
                resP2 := ph
                resSlope := slope
                resValid := true
            else
                resValid := false
        prevPH := ph
        prevPHT := phTime

    if not na(pl)
        int plTime = time[rightBars]
        if not na(prevPL) and prevPLT != plTime
            float slope = (pl - prevPL) / (plTime - prevPLT)
            bool ok = passesStructural(structF, prevPL, pl, true)
            ok := ok and passesMinSwing(minSwingF, prevPL, pl, atr14, minSwingAtr)
            ok := ok and passesSlope(slopeF, slope, barTime, atr14, minSlopeAtr, maxSlopeAtr)
            ok := ok and passesProminence(promF, pl, false, period, atr14, minPromAtr)
            ok := ok and validatePath(pathF, prevPLT, prevPL, plTime, slope, true, zband)
            int touches = countTouches(touchF, prevPLT, prevPL, slope, true, plTime, zband, minTouch)
            ok := ok and (not touchF or touches >= minTouch)
            if ok
                supT1 := prevPLT
                supP1 := prevPL
                supT2 := plTime
                supP2 := pl
                supSlope := slope
                supValid := true
            else
                supValid := false
        prevPL := pl
        prevPLT := plTime

    int extMult = ExtenSwitcher(Extensions)
    int resEndT = resValid ? resT2 + (extMult == 0 ? (time - resT2) + barTime * 10 : extMult * barTime * 25) : na
    float resEndP = resValid ? resP2 + (resEndT - resT2) * resSlope : na
    int supEndT = supValid ? supT2 + (extMult == 0 ? (time - supT2) + barTime * 10 : extMult * barTime * 25) : na
    float supEndP = supValid ? supP2 + (supEndT - supT2) * supSlope : na

    [resT1, resP1, resEndT, resEndP, resValid, supT1, supP1, supEndT, supEndP, supValid]

f_runTF(string tf) =>
    [p, ms, mp, mins, maxs] = getPreset(tf)
    period      = useAutoPreset ? p    : manualPeriod
    minSwingAtr = useAutoPreset ? ms   : manualMinSwingATR
    minPromAtr  = useAutoPreset ? mp   : manualMinProminenceATR
    minSlopeAtr = useAutoPreset ? mins : manualMinSlopeATR
    maxSlopeAtr = useAutoPreset ? maxs : manualMaxSlopeATR
    f_detect(Trendtype, period, minSwingAtr, minPromAtr, minSlopeAtr, maxSlopeAtr, useStructural, usePathValidation, useMinSwing, useSlopeFilter, useProminence, useTouchScore, minTouchCount)

// ─── MTF Security (فقط 5m / 15m / 1H) ──────────────────────────────────────
[resT1_5, resP1_5, resT2_5, resP2_5, resV_5, supT1_5, supP1_5, supT2_5, supP2_5, supV_5]       = request.security(syminfo.tickerid, TF5,  f_runTF(TF5),  lookahead=barmerge.lookahead_off)
[resT1_15, resP1_15, resT2_15, resP2_15, resV_15, supT1_15, supP1_15, supT2_15, supP2_15, supV_15] = request.security(syminfo.tickerid, TF15, f_runTF(TF15), lookahead=barmerge.lookahead_off)
[resT1_60, resP1_60, resT2_60, resP2_60, resV_60, supT1_60, supP1_60, supT2_60, supP2_60, supV_60] = request.security(syminfo.tickerid, TF60, f_runTF(TF60), lookahead=barmerge.lookahead_off)

// ─── رسم خطوط (پر — نه نقطه‌چین) ───────────────────────────────────────────
var line l_res_5  = na
var line l_sup_5  = na
var line l_res_15 = na
var line l_sup_15 = na
var line l_res_60 = na
var line l_sup_60 = na

linePrice(int t1, float p1, int t2, float p2, int atT) =>
    not na(t1) and not na(t2) and not na(p1) and not na(p2) and t1 != t2 ? p1 + (p2 - p1) / (t2 - t1) * (atT - t1) : na

clipLineStart(int t1, int t2) =>
    int tMin = math.min(t1, t2)
    int lookbackT = timenow - historyMs
    math.max(tMin, lookbackT)

drawTFLine(line ln, int x1, float y1, int x2, float y2, color col, bool valid, bool enabled) =>
    line out = ln
    int drawX1 = clipLineStart(x1, x2)
    float drawY1 = linePrice(x1, y1, x2, y2, drawX1)
    if enabled and valid and not na(x1) and not na(x2) and not na(drawY1)
        if na(out)
            out := line.new(drawX1, drawY1, x2, y2, xloc.bar_time, extend.right, color=col, width=2, style=line.style_solid)
        else
            line.set_xy1(out, drawX1, drawY1)
            line.set_xy2(out, x2, y2)
            line.set_color(out, col)
            line.set_style(out, line.style_solid)
            line.set_extend(out, extend.right)
    else if not na(out)
        line.delete(out)
        out := na
    out

l_res_5  := drawTFLine(l_res_5,  resT1_5,  resP1_5,  resT2_5,  resP2_5,  tfResColor(TF5),  resV_5,  show5m)
l_sup_5  := drawTFLine(l_sup_5,  supT1_5,  supP1_5,  supT2_5,  supP2_5,  tfSupColor(TF5),  supV_5,  show5m)
l_res_15 := drawTFLine(l_res_15, resT1_15, resP1_15, resT2_15, resP2_15, tfResColor(TF15), resV_15, show15m)
l_sup_15 := drawTFLine(l_sup_15, supT1_15, supP1_15, supT2_15, supP2_15, tfSupColor(TF15), supV_15, show15m)
l_res_60 := drawTFLine(l_res_60, resT1_60, resP1_60, resT2_60, resP2_60, tfResColor(TF60), resV_60, show1h)
l_sup_60 := drawTFLine(l_sup_60, supT1_60, supP1_60, supT2_60, supP2_60, tfSupColor(TF60), supV_60, show1h)

// ─── الگوهای کندلی ──────────────────────────────────────────────────────────
float atrSig = ta.atr(14)
float touchTol = atrSig * touchTolATR

candleRange(int i) => high[i] - low[i]
candleBody(int i) => math.abs(close[i] - open[i])
upperWick(int i) => high[i] - math.max(open[i], close[i])
lowerWick(int i) => math.min(open[i], close[i]) - low[i]

isDojiCandle(int i) =>
    float rng = candleRange(i)
    rng > 0 and candleBody(i) / rng <= dojiBodyRatio

isHammerCandle(int i) =>
    float rng = candleRange(i)
    rng > 0 and lowerWick(i) / rng >= pinWickRatio and candleBody(i) / rng <= pinBodyMax and upperWick(i) / rng <= 0.25

isShootingStarCandle(int i) =>
    float rng = candleRange(i)
    rng > 0 and upperWick(i) / rng >= pinWickRatio and candleBody(i) / rng <= pinBodyMax and lowerWick(i) / rng <= 0.25

reversalPatternAt(int i, bool atResistance) =>
    bool dojiOk = useDoji and isDojiCandle(i)
    bool pinOk = usePinBar and (atResistance ? isShootingStarCandle(i) : isHammerCandle(i))
    dojiOk or pinOk

bullishEngulfing() =>
    close > open and close[1] < open[1] and close > open[1] and open < close[1]

bearishEngulfing() =>
    close < open and close[1] > open[1] and close < open[1] and open > close[1]

touchResistance(int i, float lineP) =>
    not na(lineP) and high[i] >= lineP - touchTol and low[i] <= lineP + touchTol

touchSupport(int i, float lineP) =>
    not na(lineP) and low[i] <= lineP + touchTol and high[i] >= lineP - touchTol

// ─── سیگنال per TF ───────────────────────────────────────────────────────────
f_checkSell(bool enabled, bool valid, int rt1, float rp1, int rt2, float rp2, string tf) =>
    float resAt1 = linePrice(rt1, rp1, rt2, rp2, time[1])
    bool setup = enabled and valid and touchResistance(1, resAt1) and reversalPatternAt(1, true)
    setup and bearishEngulfing() ? tf : na

f_checkBuy(bool enabled, bool valid, int st1, float sp1, int st2, float sp2, string tf) =>
    float supAt1 = linePrice(st1, sp1, st2, sp2, time[1])
    bool setup = enabled and valid and touchSupport(1, supAt1) and reversalPatternAt(1, false)
    setup and bullishEngulfing() ? tf : na

string sellTF = enableSignals and inHistory ? f_checkSell(show5m,  resV_5,  resT1_5,  resP1_5,  resT2_5,  resP2_5,  TF5)  : na
sellTF := na(sellTF) and enableSignals and inHistory ? f_checkSell(show15m, resV_15, resT1_15, resP1_15, resT2_15, resP2_15, TF15) : sellTF
sellTF := na(sellTF) and enableSignals and inHistory ? f_checkSell(show1h,  resV_60, resT1_60, resP1_60, resT2_60, resP2_60, TF60) : sellTF

string buyTF = enableSignals and inHistory ? f_checkBuy(show5m,  supV_5,  supT1_5,  supP1_5,  supT2_5,  supP2_5,  TF5)  : na
buyTF := na(buyTF) and enableSignals and inHistory ? f_checkBuy(show15m, supV_15, supT1_15, supP1_15, supT2_15, supP2_15, TF15) : buyTF
buyTF := na(buyTF) and enableSignals and inHistory ? f_checkBuy(show1h,  supV_60, supT1_60, supP1_60, supT2_60, supP2_60, TF60) : buyTF

bool sellSignal = not na(sellTF)
bool buySignal  = not na(buyTF)

// ─── نمایش سیگنال‌ها (۷ روز گذشته) ─────────────────────────────────────────
plotshape(buySignal,  title="BUY",  style=shape.triangleup,   location=location.belowbar, color=color.new(#00E676, 0), size=size.small, text="BUY")
plotshape(sellSignal, title="SELL", style=shape.triangledown, location=location.abovebar, color=color.new(#FF1744, 0), size=size.small, text="SELL")

if showSignalLabel and buySignal
    label.new(bar_index, low, "BUY " + tfLabel(buyTF), style=label.style_label_up, color=color.new(#00E676, 10), textcolor=color.white, size=size.small)

if showSignalLabel and sellSignal
    label.new(bar_index, high, "SELL " + tfLabel(sellTF), style=label.style_label_down, color=color.new(#FF1744, 10), textcolor=color.white, size=size.small)

// ─── جدول وضعیت ───────────────────────────────────────────────────────────────
var table tfTable = table.new(position.top_right, 4, 5, bgcolor=color.new(color.black, 80), border_width=1)

f_tableRow(int row, string tf, bool enabled, bool resValid, bool supValid) =>
    [period, _, _, _, _] = getPreset(tf)
    table.cell(tfTable, 0, row, tfLabel(tf), text_color=tfColor(tf), text_size=size.small)
    table.cell(tfTable, 1, row, enabled ? "ON" : "OFF", text_color=enabled ? color.lime : color.gray, text_size=size.small)
    table.cell(tfTable, 2, row, resValid ? "R✓" : "—", text_color=resValid ? color.red : color.gray, text_size=size.small)
    table.cell(tfTable, 3, row, supValid ? "S✓" : "—", text_color=supValid ? color.green : color.gray, text_size=size.small)

if showTFTable and barstate.islast
    table.cell(tfTable, 0, 0, "TF", text_color=color.white, text_size=size.small)
    table.cell(tfTable, 1, 0, "نمایش", text_color=color.white, text_size=size.small)
    table.cell(tfTable, 2, 0, "مقاومت", text_color=color.white, text_size=size.small)
    table.cell(tfTable, 3, 0, "حمایت", text_color=color.white, text_size=size.small)
    f_tableRow(1, TF5,  show5m,  resV_5,  supV_5)
    f_tableRow(2, TF15, show15m, resV_15, supV_15)
    f_tableRow(3, TF60, show1h,  resV_60, supV_60)
    string cur = chartTFKey()
    string curTxt = na(cur) ? "چارت: غیرمجاز (5m/15m/1H)" : "چارت: " + tfLabel(cur) + " | " + str.tostring(historyDays) + " روز"
    table.cell(tfTable, 0, 4, curTxt, text_color=color.white, text_size=size.small)
    table.merge_cells(tfTable, 0, 4, 3, 4)

// ─── هشدارها ─────────────────────────────────────────────────────────────────
alertcondition(buySignal,  title="سیگنال خرید",  message="BUY — دوجی/پین‌بار + انگلفینگ صعودی — {{ticker}} {{interval}}")
alertcondition(sellSignal, title="سیگنال فروش", message="SELL — دوجی/پین‌بار + انگلفینگ نزولی — {{ticker}} {{interval}}")
