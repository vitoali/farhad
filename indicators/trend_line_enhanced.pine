//@version=5
indicator("Trendline Enhanced Detection [farhad]", shorttitle="TL Enhanced", overlay=true, max_bars_back=500, max_lines_count=500)

// ─── Core (از ChartPrime) ────────────────────────────────────────────────────
string CORE = "➞ Core Settings 🔸"
var bool TradeisON = false
var bool LongTrade = false
var bool ShortTrade = false
var float TP = 0.0
var float SL = 0.0
int BarTIME = time - time[1]
var line tpLine = na
var label LAB = na
var int UpdatedX = 0
var float UpdatedY = 0.0
var float UpdatedSLP = 0.0
var int UpdatedXLow = 0
var float UpdatedYLow = 0.0
var float UpdatedSLPLow = 0.0

int Period = input.int(10, title="Period ➞", group=CORE, inline="001")
bool Trendtype = input.string(title="Type ➞", defval="Wicks", options=["Wicks", "Body"], group=CORE, inline="001") == "Wicks"
string Extensions = input.string(title="Extend ➞", defval="  25", options=["  25", "  50", "  75", "Dynamic"], group=CORE, inline="001")
color LineCol1 = input.color(color.rgb(109, 111, 111, 19), "", group=CORE, inline="001")
bool ShowTargets = input.bool(true, "Show Targets", group=CORE, inline="002")

// ─── فیلترهای دقت تشخیص (جدید) ─────────────────────────────────────────────
string FILTER = "➞ Accuracy Filters 🔸"
bool useStructural = input.bool(true, "فیلتر ساختار (HL / LH)", group=FILTER, tooltip="حمایت: کف بالاتر | مقاومت: سقف پایین‌تر")
bool usePathValidation = input.bool(true, "اعتبارسنجی مسیر خط", group=FILTER, tooltip="قیمت نباید بین دو پیوت از خط عبور کند")
bool useMinSwing = input.bool(true, "حداقل اندازه سوینگ", group=FILTER)
float minSwingATR = input.float(0.5, "حداقل سوینگ (× ATR)", minval=0.1, maxval=5.0, step=0.1, group=FILTER)
bool useSlopeFilter = input.bool(true, "فیلتر زاویه خط", group=FILTER)
float minSlopeATR = input.float(0.02, "حداقل شیب (× ATR/کندل)", minval=0.0, maxval=1.0, step=0.01, group=FILTER)
float maxSlopeATR = input.float(1.5, "حداکثر شیب (× ATR/کندل)", minval=0.1, maxval=5.0, step=0.1, group=FILTER)
bool useProminence = input.bool(true, "فیلتر برجستگی پیوت", group=FILTER)
float minProminenceATR = input.float(0.3, "حداقل برجستگی (× ATR)", minval=0.0, maxval=3.0, step=0.1, group=FILTER)
bool useTouchScore = input.bool(true, "امتیاز برخورد با خط", group=FILTER)
int minTouchCount = input.int(1, "حداقل برخورد بعد از تشکیل", minval=0, maxval=5, group=FILTER)
bool enableSignals = input.bool(false, "فعال‌سازی سیگنال (بعداً)", group=FILTER, tooltip="فعلاً خاموش — بعداً فعال می‌کنیم")

ExtenSwitcher(ex) =>
    switch ex
        "  25" => 1
        "  50" => 2
        "  75" => 3
        => 0  // Dynamic

method volAdj(int len) =>
    math.min(ta.atr(len) * 0.3, close * (0.3 / 100))[20] / 2

Zband = volAdj(30)
float atr14 = ta.atr(14)

// ─── توابع اعتبارسنجی (جدید) ─────────────────────────────────────────────────
passesStructural(float prevPivot, float currPivot, bool isSupport) =>
    not useStructural or (isSupport ? currPivot >= prevPivot : currPivot <= prevPivot)

passesMinSwing(float prevPivot, float currPivot) =>
    not useMinSwing or math.abs(currPivot - prevPivot) >= atr14 * minSwingATR

passesSlope(float slope) =>
    if not useSlopeFilter
        true
    else
        slopePerBar = math.abs(slope * BarTIME)
        slopePerBar >= atr14 * minSlopeATR and slopePerBar <= atr14 * maxSlopeATR

passesProminence(float pivotVal, bool isHigh) =>
    if not useProminence
        true
    else
        float prominence = isHigh ? pivotVal - ta.lowest(low, Period * 2) : ta.highest(high, Period * 2) - pivotVal
        prominence >= atr14 * minProminenceATR

validateLinePath(int startTime, float startPrice, int endTime, float slope, bool isSupport) =>
    if not usePathValidation or startTime == endTime
        true
    else
        bool valid = true
        int tMin = math.min(startTime, endTime)
        int tMax = math.max(startTime, endTime)
        int maxLook = math.min(500, bar_index)
        for i = 0 to maxLook
            int t = time[i]
            if t >= tMin and t <= tMax
                float linePrice = startPrice + (t - startTime) * slope
                if isSupport and low[i] < linePrice - Zband
                    valid := false
                if not isSupport and high[i] > linePrice + Zband
                    valid := false
        valid

countLineTouches(int startTime, float startPrice, float slope, bool isSupport, int fromTime) =>
    int touches = 0
    int maxLook = math.min(300, bar_index)
    for i = 0 to maxLook
        if time[i] < fromTime
            break
        float lp = startPrice + (time[i] - startTime) * slope
        bool touched = isSupport ? math.abs(low[i] - lp) <= Zband * 1.5 : math.abs(high[i] - lp) <= Zband * 1.5
        if touched
            touches += 1
    touches

passesAllFilters(float prevPivot, float currPivot, float slope, int startTime, int endTime, bool isSupport) =>
    isHigh = not isSupport
    passesStructural(prevPivot, currPivot, isSupport) and passesMinSwing(prevPivot, currPivot) and passesSlope(slope) and passesProminence(currPivot, isHigh) and validateLinePath(startTime, prevPivot, endTime, slope, isSupport)

// ─── رسم ترندلاین (بهبودیافته) ───────────────────────────────────────────────
method Trendlines(float src, int timeIndex, bool dir) =>
    var int Start = 1
    var int End = 0
    var int TIME = 1
    var float YEnd = 0.0
    var float YStart = 0.0
    var float Slope = 0.0
    var line Line1 = line.new(na, na, na, na)
    var line Line2 = line.new(na, na, na, na)
    var line Line3 = line.new(na, na, na, na)
    var bool lineValid = false

    SCR = fixnan(src)
    if ta.change(SCR) != 0
        TIME := time[timeIndex]
        YStart := SCR[1]
        Start := TIME[1]
        Slope := (SCR - YStart) / (TIME - Start)

    int extMult = ExtenSwitcher(Extensions)
    int EXTime = extMult == 0 ? (time - TIME) + BarTIME * 10 : extMult * BarTIME * 25
    End := TIME + EXTime
    YEnd := SCR + EXTime * Slope

    bool filtersOk = passesAllFilters(YStart, SCR, Slope, Start, TIME, dir)
    int touches = useTouchScore ? countLineTouches(Start, YStart, Slope, dir, TIME) : minTouchCount
    bool touchOk = not useTouchScore or touches >= minTouchCount

    if ta.change(SCR) != 0 and not TradeisON[1] and filtersOk and touchOk
        lineValid := true
        LineCond = Slope * time < 0 ? dir ? na : color.rgb(11, 139, 7, 53) : dir ? color.rgb(212, 46, 0, 54) : na
        if not na(LineCond)
            Line1 := line.new(Start, YStart, End, YEnd, xloc.bar_time, extend.none, color=color.new(color.white, 100))
            Line2 := line.new(Start, YStart - Zband * 2, End, YEnd - Zband * 2, xloc.bar_time, extend.none, color=color.new(color.black, 100))
            Line3 := line.new(Start, YStart - Zband * 1, End, YEnd - Zband * 1, xloc.bar_time, extend.none, color=color.new(color.black, 100))
            linefill.new(Line3, Line2, color=LineCol1)
            linefill.new(Line3, Line1, color=LineCond)
    else if ta.change(SCR) != 0
        lineValid := false

    [Start, YStart, Slope, lineValid]

method GetlinePrice(int TIME, float Price, float SLOP, int LookB) =>
    var float Current = 0.0
    EsTime = time - TIME
    Current := Price + (EsTime - LookB * BarTIME) * SLOP
    Current

method CheckCross(float Price, int StartTime, float StartPrice, float SLP) =>
    var float Current = 0.0
    var float Previous = 0.0
    if StartPrice[Period] != StartPrice
        Current := GetlinePrice(StartTime, StartPrice, SLP, 0)
        Previous := GetlinePrice(StartTime, StartPrice, SLP, 1)
        Crossover = Price[1] < Previous and Price > Current ? 1 : Price[1] > Previous - Zband * 0.1 and Price < Current - Zband * 0.1 ? -1 : 0
        Crossover
    else
        0

// ─── پیوت‌ها ─────────────────────────────────────────────────────────────────
PH = ta.pivothigh(Trendtype ? high : close > open ? close : open, Period, Period / 2)
PL = ta.pivotlow(Trendtype ? low : close > open ? open : close, Period, Period / 2)

[Xx, XZ, SLPXZ, resValid] = Trendlines(PH, Period / 2, false)
[XxL, XZL, SLPXZL, supValid] = Trendlines(PL, Period / 2, true)

if ta.change(fixnan(PH)) != 0 and resValid
    UpdatedX := Xx
    UpdatedY := XZ
    UpdatedSLP := SLPXZ

if ta.change(fixnan(PL)) != 0 and supValid
    UpdatedXLow := XxL
    UpdatedYLow := XZL
    UpdatedSLPLow := SLPXZL

// ─── سیگنال (فعلاً خاموش — بعداً فعال می‌شود) ───────────────────────────────
Long = enableSignals and not (UpdatedSLP * time > 0) and CheckCross(close, UpdatedX, UpdatedY, UpdatedSLP) == 1 and not TradeisON
Short = enableSignals and not (UpdatedSLPLow * time < 0) and CheckCross(close, UpdatedXLow, UpdatedYLow, UpdatedSLPLow) == -1 and not TradeisON

TradeFire = Long or Short

if Long and not TradeisON
    LongTrade := true
    ShortTrade := false

if Short and not TradeisON
    LongTrade := false
    ShortTrade := true

if enableSignals
    if TradeFire and not TradeisON
        TP := Long ? high + Zband * 20 : low - Zband * 20
        SL := Long ? low - Zband * 20 : high + Zband * 20
        TradeisON := true
        if ShowTargets
            line.new(bar_index, Long ? high : low, bar_index, TP, width=2, color=color.rgb(154, 103, 20), style=line.style_dashed)
            tpLine := line.new(bar_index, TP, bar_index + 2, TP, style=line.style_dashed, color=color.rgb(154, 103, 20))
            LAB := label.new(bar_index, TP, "Target", color=color.rgb(154, 103, 20), style=label.style_label_left, size=size.small, textcolor=color.white)

    if TradeisON
        line.set_x2(tpLine, bar_index)
        label.set_x(LAB, bar_index + 1)

    if LongTrade and TradeisON
        if high >= TP
            label.set_color(LAB, color.rgb(6, 128, 10, 37))
            TradeisON := false
        if close <= SL
            label.set_color(LAB, color.new(color.rgb(246, 7, 7), 70))
            TradeisON := false
    else if ShortTrade and TradeisON
        if low <= TP
            label.set_color(LAB, color.rgb(6, 128, 10, 37))
            TradeisON := false
        if close >= SL
            label.set_color(LAB, color.new(color.rgb(246, 7, 7), 70))
            TradeisON := false

plotshape(enableSignals and Long and not TradeisON[1], size=size.small, color=color.rgb(46, 192, 6, 11), location=location.belowbar, style=shape.labelup, text="", textcolor=color.white)
plotshape(enableSignals and Short and not TradeisON[1], size=size.small, color=color.rgb(241, 2, 2, 11), location=location.abovebar, style=shape.labeldown, text="", textcolor=color.white)

// ─── نمایش وضعیت فیلترها ─────────────────────────────────────────────────────
plotchar(resValid and ta.change(fixnan(PH)) != 0, "Res Valid", "R", location=location.abovebar, color=color.new(color.red, 30), size=size.tiny)
plotchar(supValid and ta.change(fixnan(PL)) != 0, "Sup Valid", "S", location=location.belowbar, color=color.new(color.green, 30), size=size.tiny)
