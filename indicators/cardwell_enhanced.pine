//@version=6
indicator("Cardwell Enhanced [farhad]", shorttitle="Cardwell+", overlay=true, max_labels_count=500, max_lines_count=500)

// ── CORE ────────────────────────────────────────────────────────
var string GRP_CORE = "⚙️ Core Settings"
i_rsiLen     = input.int(14, "RSI Length", minval=1, group=GRP_CORE)
i_rsiSrc     = input.source(close, "Source", group=GRP_CORE)
i_trendLen   = input.int(50, "Trend MA Length", minval=1, group=GRP_CORE)
i_trendSrc   = input.source(close, "Trend Source", group=GRP_CORE)

// ── FILTERS (اصلی Cardwell) ───────────────────────────────────
var string GRP_FILT = "🕯️ Cardwell Filters"
i_bullLo      = input.int(40, "Bull Range Low", minval=0, maxval=100, group=GRP_FILT)
i_bullHi      = input.int(80, "Bull Range High", minval=0, maxval=100, group=GRP_FILT)
i_bearLo      = input.int(20, "Bear Range Low", minval=0, maxval=100, group=GRP_FILT)
i_bearHi      = input.int(60, "Bear Range High", minval=0, maxval=100, group=GRP_FILT)
i_confirmBars = input.int(3, "Regime Confirm Bars", minval=1, group=GRP_FILT, tooltip="پیش‌فرض 3 — کمتر whipsaw")
i_useHtf      = input.bool(false, "Use HTF Confirmation", group=GRP_FILT)
i_htfTF       = input.timeframe("240", "HTF Timeframe", group=GRP_FILT)

// ── فیلترهای بهبودیافته (از بک‌تست) ───────────────────────────
var string GRP_ENH = "🛡️ Enhanced Filters (بک‌تست)"
i_useAdx        = input.bool(true, "Chop Filter (ADX)", group=GRP_ENH, tooltip="حذف سیگنال در رنج")
i_adxLen        = input.int(14, "ADX Length", minval=1, group=GRP_ENH)
i_adxMin        = input.int(22, "ADX Min Strength", minval=0, maxval=100, group=GRP_ENH)
i_useMaDist     = input.bool(true, "حداقل فاصله از MA", group=GRP_ENH)
i_minMaDistPct  = input.float(0.15, "Min MA Distance (%)", minval=0.0, step=0.05, group=GRP_ENH)
i_useRsiMom     = input.bool(true, "RSI Momentum", group=GRP_ENH, tooltip="Long: RSI صعودی | Short: RSI نزولی")
i_useLateRsi    = input.bool(true, "Late RSI Cut", group=GRP_ENH)
i_maxLongRsi    = input.int(68, "Max RSI for Long", minval=50, maxval=90, group=GRP_ENH)
i_minShortRsi   = input.int(32, "Min RSI for Short", minval=10, maxval=50, group=GRP_ENH)
i_useCooldown   = input.bool(true, "Signal Cooldown", group=GRP_ENH)
i_cooldownBars  = input.int(4, "Cooldown Bars", minval=1, maxval=50, group=GRP_ENH)

// ── TRADE TOOLS ─────────────────────────────────────────────────
var string GRP_TT = "📐 Trade Tools"
i_atrLen      = input.int(14, "ATR Length", minval=1, group=GRP_TT)
i_slMult      = input.float(1.5, "SL ATR Mult", minval=0.1, step=0.1, group=GRP_TT)
i_tp1Mult     = input.float(1.0, "TP1 ATR Mult", minval=0.1, step=0.1, group=GRP_TT)
i_tp2Mult     = input.float(2.0, "TP2 ATR Mult", minval=0.1, step=0.1, group=GRP_TT)
i_tp3Mult     = input.float(3.0, "TP3 ATR Mult", minval=0.1, step=0.1, group=GRP_TT)
i_lineExtBars = input.int(50, "Level Line Extend Bars", minval=1, group=GRP_TT)

// ── VISUALS ─────────────────────────────────────────────────────
var string GRP_VIS = "🎨 Visuals"
i_showCandles = input.bool(true, "Color Candles", group=GRP_VIS)
i_showSignals = input.bool(true, "Show Buy/Sell Signals", group=GRP_VIS)
i_showLevels  = input.bool(true, "Show Trade Levels", group=GRP_VIS)
i_showBlocked = input.bool(false, "Show Blocked Signals (x)", group=GRP_VIS)

var string GRP_DASH = "📊 Dashboard"
i_showDash = input.bool(true, "Show Dashboard", group=GRP_DASH)
i_dashPos  = input.string(position.top_right, "Dashboard Position", options=[position.top_right, position.top_left, position.bottom_right, position.bottom_left], group=GRP_DASH)

var string GRP_COL = "🌈 Colors"
c_bullCandle = input.color(color.new(#26a69a, 0), "Bull Candle", group=GRP_COL)
c_bearCandle = input.color(color.new(#ef5350, 0), "Bear Candle", group=GRP_COL)
c_neutCandle = input.color(color.new(#787b86, 0), "Neutral Candle", group=GRP_COL)
c_buySig     = input.color(#2196f3, "Buy Signal", group=GRP_COL)
c_sellSig    = input.color(#ff9800, "Sell Signal", group=GRP_COL)
c_slColor    = input.color(#ef5350, "SL Line", group=GRP_COL)
c_entryColor = input.color(#2196f3, "Entry Line", group=GRP_COL)
c_tp1Color   = input.color(color.new(#26a69a, 40), "TP1 Line", group=GRP_COL)
c_tp2Color   = input.color(color.new(#26a69a, 20), "TP2 Line", group=GRP_COL)
c_tp3Color   = input.color(color.new(#26a69a, 0), "TP3 Line", group=GRP_COL)
c_riskFill   = input.color(color.new(#ef5350, 80), "Risk Zone", group=GRP_COL)
c_rewardFill = input.color(color.new(#26a69a, 85), "Reward Zone", group=GRP_COL)
c_dashBg     = input.color(color.new(#0a0f1a, 10), "Dash BG", group=GRP_COL)
c_dashHdr    = input.color(color.new(#14b5cb, 20), "Dash Header", group=GRP_COL)

// ── CORE LOGIC ──────────────────────────────────────────────────
rsiVal      = ta.rsi(i_rsiSrc, i_rsiLen)
rsiPrev     = rsiVal[1]
trendMA     = ta.sma(i_trendSrc, i_trendLen)
maDistPct   = math.abs(i_trendSrc - trendMA) / trendMA * 100
isUptrend   = i_trendSrc > trendMA
isDowntrend = i_trendSrc < trendMA

inBullRange = rsiVal >= i_bullLo and rsiVal <= i_bullHi
inBearRange = rsiVal >= i_bearLo and rsiVal <= i_bearHi

bullRegimeRaw = isUptrend and inBullRange
bearRegimeRaw = isDowntrend and inBearRange

var int bullConfirmCount = 0
var int bearConfirmCount = 0
bullConfirmCount := bullRegimeRaw ? bullConfirmCount + 1 : 0
bearConfirmCount := bearRegimeRaw ? bearConfirmCount + 1 : 0

bullRegime = bullRegimeRaw and bullConfirmCount >= i_confirmBars
bearRegime = bearRegimeRaw and bearConfirmCount >= i_confirmBars

regimeState     = bullRegime ? 1 : bearRegime ? -1 : 0
prevRegimeState = regimeState[1]

f_cardwellRegime() =>
    _rsi = ta.rsi(i_rsiSrc, i_rsiLen)
    _ma  = ta.sma(i_trendSrc, i_trendLen)
    _up  = i_trendSrc > _ma
    _dn  = i_trendSrc < _ma
    _br  = _rsi >= i_bullLo and _rsi <= i_bullHi
    _be  = _rsi >= i_bearLo and _rsi <= i_bearHi
    _bullRaw = _up and _br
    _bearRaw = _dn and _be
    var int _bc = 0
    var int _ec = 0
    _bc := _bullRaw ? _bc + 1 : 0
    _ec := _bearRaw ? _ec + 1 : 0
    _bull = _bullRaw and _bc >= i_confirmBars
    _bear = _bearRaw and _ec >= i_confirmBars
    _bull ? 1 : _bear ? -1 : 0

htfRegimeState = request.security(syminfo.tickerid, i_htfTF, f_cardwellRegime(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
htfBullOk = not i_useHtf or htfRegimeState == 1
htfBearOk = not i_useHtf or htfRegimeState == -1

[_, _, adxVal] = ta.dmi(i_adxLen, i_adxLen)
chopOk    = not i_useAdx or adxVal >= i_adxMin
maDistOk  = not i_useMaDist or maDistPct >= i_minMaDistPct
rsiMomLong  = not i_useRsiMom or rsiVal > rsiPrev
rsiMomShort = not i_useRsiMom or rsiVal < rsiPrev
lateLongOk  = not i_useLateRsi or rsiVal <= i_maxLongRsi
lateShortOk = not i_useLateRsi or rsiVal >= i_minShortRsi

// سیگنال خام Cardwell (قبل از فیلترهای enhanced)
longRaw  = regimeState == 1 and prevRegimeState != 1 and htfBullOk
shortRaw = regimeState == -1 and prevRegimeState != -1 and htfBearOk

enhLongOk  = chopOk and maDistOk and rsiMomLong and lateLongOk
enhShortOk = chopOk and maDistOk and rsiMomShort and lateShortOk

var int lastSigBar = na
cooldownOk = not i_useCooldown or na(lastSigBar) or bar_index - lastSigBar >= i_cooldownBars

longSignal  = longRaw and enhLongOk and cooldownOk
shortSignal = shortRaw and enhShortOk and cooldownOk

if longSignal or shortSignal
    lastSigBar := bar_index

blockedLong  = longRaw and not longSignal
blockedShort = shortRaw and not shortSignal

atrVal     = ta.atr(i_atrLen)
entryPrice = close
slLong     = entryPrice - atrVal * i_slMult
tp1Long    = entryPrice + atrVal * i_tp1Mult
tp2Long    = entryPrice + atrVal * i_tp2Mult
tp3Long    = entryPrice + atrVal * i_tp3Mult
slShort    = entryPrice + atrVal * i_slMult
tp1Short   = entryPrice - atrVal * i_tp1Mult
tp2Short   = entryPrice - atrVal * i_tp2Mult
tp3Short   = entryPrice - atrVal * i_tp3Mult

bodyColor = bullRegime ? c_bullCandle : bearRegime ? c_bearCandle : c_neutCandle

// ── ALERTS ──────────────────────────────────────────────────────
alertcondition(longSignal and barstate.isconfirmed, "BUY Signal", "Cardwell+ BUY — {{ticker}} {{interval}}")
alertcondition(shortSignal and barstate.isconfirmed, "SELL Signal", "Cardwell+ SELL — {{ticker}} {{interval}}")
alertcondition(shortSignal and barstate.isconfirmed, "Close Long", "Cardwell+ Close Long — {{ticker}}")
alertcondition(longSignal and barstate.isconfirmed, "Close Short", "Cardwell+ Close Short — {{ticker}}")

// ── VISUALS ─────────────────────────────────────────────────────
plotcandle(open, high, low, close, title="Heatmap Candles", color=i_showCandles ? bodyColor : na, wickcolor=i_showCandles ? bodyColor : na, bordercolor=i_showCandles ? color.black : na)

plotshape(i_showSignals and longSignal, title="BUY", style=shape.labelup, location=location.belowbar, color=c_buySig, text="BUY", textcolor=color.white, size=size.small)
plotshape(i_showSignals and shortSignal, title="SELL", style=shape.labeldown, location=location.abovebar, color=c_sellSig, text="SELL", textcolor=color.white, size=size.small)
plotchar(i_showBlocked and blockedLong, title="Blocked Long", char="x", location=location.belowbar, color=color.new(color.gray, 30), size=size.tiny)
plotchar(i_showBlocked and blockedShort, title="Blocked Short", char="x", location=location.abovebar, color=color.new(color.gray, 30), size=size.tiny)

var line slLine = na
var line entryLine = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
var label slLbl = na
var label entryLbl = na
var label tp1Lbl = na
var label tp2Lbl = na
var label tp3Lbl = na
var linefill riskFill = na
var linefill rewardFill = na
var int levelEndBar = na

f_deleteLevels() =>
    line.delete(slLine)
    line.delete(entryLine)
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(tp3Line)
    label.delete(slLbl)
    label.delete(entryLbl)
    label.delete(tp1Lbl)
    label.delete(tp2Lbl)
    label.delete(tp3Lbl)
    linefill.delete(riskFill)
    linefill.delete(rewardFill)

if i_showLevels and (longSignal or shortSignal)
    f_deleteLevels()
    float slP  = longSignal ? slLong : slShort
    float tp1P = longSignal ? tp1Long : tp1Short
    float tp2P = longSignal ? tp2Long : tp2Short
    float tp3P = longSignal ? tp3Long : tp3Short
    levelEndBar := bar_index + i_lineExtBars
    slLine    := line.new(bar_index, slP, levelEndBar, slP, color=c_slColor, width=2)
    entryLine := line.new(bar_index, entryPrice, levelEndBar, entryPrice, color=c_entryColor, style=line.style_dashed)
    tp1Line   := line.new(bar_index, tp1P, levelEndBar, tp1P, color=c_tp1Color, style=line.style_dashed)
    tp2Line   := line.new(bar_index, tp2P, levelEndBar, tp2P, color=c_tp2Color, style=line.style_dashed)
    tp3Line   := line.new(bar_index, tp3P, levelEndBar, tp3P, color=c_tp3Color, style=line.style_dashed)
    slLbl    := label.new(levelEndBar, slP, "SL " + str.tostring(slP, format.mintick), style=label.style_label_left, color=c_slColor, textcolor=color.white, size=size.small)
    entryLbl := label.new(levelEndBar, entryPrice, "Entry " + str.tostring(entryPrice, format.mintick), style=label.style_label_left, color=c_entryColor, textcolor=color.white, size=size.small)
    tp1Lbl   := label.new(levelEndBar, tp1P, "TP1 " + str.tostring(tp1P, format.mintick), style=label.style_label_left, color=c_tp1Color, textcolor=color.white, size=size.small)
    tp2Lbl   := label.new(levelEndBar, tp2P, "TP2 " + str.tostring(tp2P, format.mintick), style=label.style_label_left, color=c_tp2Color, textcolor=color.white, size=size.small)
    tp3Lbl   := label.new(levelEndBar, tp3P, "TP3 " + str.tostring(tp3P, format.mintick), style=label.style_label_left, color=c_tp3Color, textcolor=color.white, size=size.small)
    riskFill   := linefill.new(slLine, entryLine, c_riskFill)
    rewardFill := linefill.new(entryLine, tp3Line, c_rewardFill)

if not na(slLine)
    label.set_x(slLbl, levelEndBar)
    label.set_x(entryLbl, levelEndBar)
    label.set_x(tp1Lbl, levelEndBar)
    label.set_x(tp2Lbl, levelEndBar)
    label.set_x(tp3Lbl, levelEndBar)

// ── DASHBOARD ───────────────────────────────────────────────────
f_passTxt(bool ok) => ok ? "PASS" : "BLOCK"
f_passClr(bool ok) => ok ? c_bullCandle : c_bearCandle

var table dash = table.new(i_dashPos, 2, 14, border_width=1)

if i_showDash and barstate.islast
    table.cell(dash, 0, 0, "Cardwell+ Enhanced", text_color=color.white, bgcolor=c_dashHdr, text_size=size.normal)
    table.cell(dash, 1, 0, "", bgcolor=c_dashHdr)

    table.cell(dash, 0, 1, "Regime", bgcolor=c_dashBg, text_color=color.gray, text_size=size.small)
    string regTxt = bullRegime ? "BULL" : bearRegime ? "BEAR" : "NEUTRAL"
    table.cell(dash, 1, 1, regTxt, bgcolor=c_dashBg, text_color=bullRegime ? c_bullCandle : bearRegime ? c_bearCandle : c_neutCandle, text_size=size.small)

    table.cell(dash, 0, 2, "RSI", bgcolor=c_dashBg, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(rsiVal, "#.#"), bgcolor=c_dashBg, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 3, "ADX Filter", bgcolor=c_dashBg, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 3, not i_useAdx ? "OFF" : str.tostring(adxVal, "#.#") + " " + f_passTxt(chopOk), bgcolor=c_dashBg, text_color=f_passClr(chopOk), text_size=size.small)

    table.cell(dash, 0, 4, "MA Distance", bgcolor=c_dashBg, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(maDistPct, "#.##") + "% " + f_passTxt(maDistOk), bgcolor=c_dashBg, text_color=f_passClr(maDistOk), text_size=size.small)

    table.cell(dash, 0, 5, "RSI Momentum", bgcolor=c_dashBg, text_color=color.gray, text_size=size.small)
    string momTxt = rsiVal > rsiPrev ? "UP" : rsiVal < rsiPrev ? "DOWN" : "FLAT"
    table.cell(dash, 1, 5, momTxt, bgcolor=c_dashBg, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 6, "Late RSI", bgcolor=c_dashBg, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 6, "L≤" + str.tostring(i_maxLongRsi) + " S≥" + str.tostring(i_minShortRsi), bgcolor=c_dashBg, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 7, "Cooldown", bgcolor=c_dashBg, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 7, i_useCooldown ? str.tostring(i_cooldownBars) + " bars " + f_passTxt(cooldownOk) : "OFF", bgcolor=c_dashBg, text_color=f_passClr(cooldownOk), text_size=size.small)

    table.cell(dash, 0, 8, "HTF", bgcolor=c_dashBg, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 8, not i_useHtf ? "OFF" : htfRegimeState == 1 ? "BULL" : htfRegimeState == -1 ? "BEAR" : "NEUT", bgcolor=c_dashBg, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 9, "Confirm", bgcolor=c_dashBg, text_color=color.gray, text_size=size.small)
    int confCnt = bullRegimeRaw ? bullConfirmCount : bearRegimeRaw ? bearConfirmCount : 0
    table.cell(dash, 1, 9, str.tostring(confCnt) + "/" + str.tostring(i_confirmBars), bgcolor=c_dashBg, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 10, "ATR", bgcolor=c_dashBg, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 10, str.tostring(atrVal, format.mintick), bgcolor=c_dashBg, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 11, "Long Ready", bgcolor=c_dashBg, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 11, f_passTxt(enhLongOk and cooldownOk), bgcolor=c_dashBg, text_color=f_passClr(enhLongOk and cooldownOk), text_size=size.small)

    table.cell(dash, 0, 12, "Short Ready", bgcolor=c_dashBg, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 12, f_passTxt(enhShortOk and cooldownOk), bgcolor=c_dashBg, text_color=f_passClr(enhShortOk and cooldownOk), text_size=size.small)

    table.cell(dash, 0, 13, "R:R TP3/SL", bgcolor=c_dashBg, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 13, str.tostring(i_tp3Mult / i_slMult, "#.##"), bgcolor=c_dashBg, text_color=color.white, text_size=size.small)
