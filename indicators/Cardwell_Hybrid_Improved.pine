// Cardwell Hybrid Improved — based on MarkitTick Cardwell Range Analyze
// Improvements from backtest analysis (BTC / XAU / EURUSD, ~3 months):
//  1) Anti-flip cooldown + one-signal-per-leg (borrowed from EWO/RSI)
//  2) MACD direction filter (borrowed from CM MACD)
//  3) EWO momentum-turn filter (borrowed from EWO/RSI)
//  4) ADX chop filter + HTF regime ON by default for lower TFs
//  5) Real trade state: when SL or TP is hit, close the signal, clear levels,
//     fire close alert, then resume scanning for the NEXT signal
//@version=6
indicator("Cardwell Hybrid Improved", overlay=true, max_labels_count=500, max_lines_count=500)

// ── INPUTS ──────────────────────────────────────────────────────
var string GRP_CORE = "Core Settings"
i_rsiLen        = input.int(14, "RSI Length", minval=1, group=GRP_CORE)
i_rsiSrc        = input.source(close, "Source", group=GRP_CORE)
i_trendLen      = input.int(50, "Trend MA Length", minval=1, group=GRP_CORE)
i_trendSrc      = input.source(close, "Trend Source", group=GRP_CORE)

var string GRP_FILT = "Cardwell Regime"
i_bullLo        = input.int(40, "Bull Range Low", minval=0, maxval=100, group=GRP_FILT)
i_bullHi        = input.int(80, "Bull Range High", minval=0, maxval=100, group=GRP_FILT)
i_bearLo        = input.int(20, "Bear Range Low", minval=0, maxval=100, group=GRP_FILT)
i_bearHi        = input.int(60, "Bear Range High", minval=0, maxval=100, group=GRP_FILT)
i_confirmBars   = input.int(3, "Regime Confirm Bars", minval=1, group=GRP_FILT)

var string GRP_HYB = "Hybrid Filters (raise win-rate / cut flips)"
i_useMacd       = input.bool(true, "MACD Direction Filter", group=GRP_HYB)
i_macdFast      = input.int(12, "MACD Fast", minval=1, group=GRP_HYB)
i_macdSlow      = input.int(26, "MACD Slow", minval=1, group=GRP_HYB)
i_macdSig       = input.int(9, "MACD Signal", minval=1, group=GRP_HYB)
i_useEwo        = input.bool(true, "EWO Momentum Turn Filter", group=GRP_HYB)
i_ewoFast       = input.int(5, "EWO Fast", minval=1, group=GRP_HYB)
i_ewoSlow       = input.int(34, "EWO Slow", minval=1, group=GRP_HYB)
i_useAdx        = input.bool(true, "ADX Chop Filter", group=GRP_HYB)
i_adxLen        = input.int(14, "ADX Length", minval=1, group=GRP_HYB)
i_adxMin        = input.int(18, "ADX Min Strength", minval=0, maxval=100, group=GRP_HYB)
i_useHtf        = input.bool(true, "HTF Regime Confirmation", group=GRP_HYB)
i_htfTF         = input.timeframe("60", "HTF Timeframe", group=GRP_HYB)

var string GRP_ANTI = "Anti-Flip / Signal Lock"
i_minFlipBars   = input.int(8, "Min Bars Before Opposite Signal", minval=0, group=GRP_ANTI)
i_onePerLeg     = input.bool(true, "One Primary Signal Per Regime Leg", group=GRP_ANTI)
i_lockUntilExit = input.bool(true, "Ignore New Signals Until SL/TP Exit", group=GRP_ANTI)

var string GRP_TT = "Trade Tools / SL-TP Mode"
i_riskMode      = input.string("ATR", "SL/TP Mode", options=["ATR", "Percent", "Pips"], group=GRP_TT)
i_atrLen        = input.int(14, "ATR Length", minval=1, group=GRP_TT)
i_slMult        = input.float(1.5, "SL ATR Mult", minval=0.1, step=0.1, group=GRP_TT)
i_tp1Mult       = input.float(1.0, "TP1 ATR Mult", minval=0.1, step=0.1, group=GRP_TT)
i_tp2Mult       = input.float(2.0, "TP2 ATR Mult", minval=0.1, step=0.1, group=GRP_TT)
i_tp3Mult       = input.float(3.0, "TP3 ATR Mult", minval=0.1, step=0.1, group=GRP_TT)
i_slPct         = input.float(3.0, "SL Percent (BTC mode)", minval=0.1, step=0.1, group=GRP_TT)
i_tpPct         = input.float(5.0, "TP Percent (BTC mode)", minval=0.1, step=0.1, group=GRP_TT)
i_slPips        = input.float(5.0, "SL Pips", minval=0.1, step=0.1, group=GRP_TT)
i_tpPips        = input.float(5.0, "TP Pips", minval=0.1, step=0.1, group=GRP_TT)
i_pipSize       = input.float(0.0001, "Pip Size (EUR=0.0001, XAU≈1.0)", minval=0.00001, step=0.0001, group=GRP_TT)
i_lineExtBars   = input.int(50, "Level Line Max Extend Bars", minval=1, group=GRP_TT)

var string GRP_VIS = "Visuals"
i_showCandles   = input.bool(true, "Color Candles", group=GRP_VIS)
i_showSignals   = input.bool(true, "Show Buy/Sell Signals", group=GRP_VIS)
i_showLevels    = input.bool(true, "Show Trade Levels", group=GRP_VIS)
i_showExitMarks = input.bool(true, "Show SL/TP Exit Marks", group=GRP_VIS)

var string GRP_DASH = "Dashboard"
i_showDash      = input.bool(true, "Show Dashboard", group=GRP_DASH)
i_dashPos       = input.string(position.top_right, "Dashboard Position", options=[position.top_right, position.top_left, position.bottom_right, position.bottom_left], group=GRP_DASH)

var string GRP_WH = "Alerts"
i_actionLong        = input.string("long",        "Long Action",        group=GRP_WH)
i_actionShort       = input.string("short",       "Short Action",       group=GRP_WH)
i_actionCloseLong   = input.string("closelong",   "Close Long Action",  group=GRP_WH)
i_actionCloseShort  = input.string("closeshort",  "Close Short Action", group=GRP_WH)

var string GRP_COL = "Colors"
c_bullCandle    = input.color(color.new(#26a69a, 0), "Bull Candle Body", group=GRP_COL)
c_bearCandle    = input.color(color.new(#ef5350, 0), "Bear Candle Body", group=GRP_COL)
c_neutCandle    = input.color(color.new(#787b86, 0), "Neutral Candle Body", group=GRP_COL)
c_wickBorder    = input.color(color.new(#000000, 0), "Candle Border/Wick", group=GRP_COL)
c_buySig        = input.color(#2196f3, "Buy Signal", group=GRP_COL)
c_sellSig       = input.color(#ff9800, "Sell Signal", group=GRP_COL)
c_slColor       = input.color(#ef5350, "SL Line", group=GRP_COL)
c_entryColor    = input.color(#2196f3, "Entry Line", group=GRP_COL)
c_tp1Color      = input.color(color.new(#26a69a, 40), "TP1 Line", group=GRP_COL)
c_tp2Color      = input.color(color.new(#26a69a, 20), "TP2 Line", group=GRP_COL)
c_tp3Color      = input.color(color.new(#26a69a, 0), "TP3 Line", group=GRP_COL)
c_riskFill      = input.color(color.new(#ef5350, 80), "Risk Zone Fill", group=GRP_COL)
c_rewardFill    = input.color(color.new(#26a69a, 85), "Reward Zone Fill", group=GRP_COL)
c_dashBg        = input.color(color.new(#0a0f1a, 10), "Dashboard Background", group=GRP_COL)
c_dashHeaderBg  = input.color(color.new(#14b5cb, 20), "Dashboard Header BG", group=GRP_COL)
c_dashLabelTxt  = input.color(color.new(#ffffff, 30), "Dashboard Label Text", group=GRP_COL)
c_dashValBg     = input.color(color.new(#0d1117, 0), "Dashboard Value BG", group=GRP_COL)
c_dashValTxt    = input.color(color.new(#ffffff, 0), "Dashboard Value Text", group=GRP_COL)

// ── CORE CARDWELL REGIME ────────────────────────────────────────
rsiVal      = ta.rsi(i_rsiSrc, i_rsiLen)
trendMA     = ta.sma(i_trendSrc, i_trendLen)
isUptrend   = i_trendSrc > trendMA
isDowntrend = i_trendSrc < trendMA

inBullRange = rsiVal >= i_bullLo and rsiVal <= i_bullHi
inBearRange = rsiVal >= i_bearLo and rsiVal <= i_bearHi

bullRegimeRaw = isUptrend and inBullRange
bearRegimeRaw = isDowntrend and inBearRange

var int bullConfirmCount = 0
var int bearConfirmCount = 0
bullConfirmCount := bullRegimeRaw ? bullConfirmCount + 1 : 0
bearConfirmCount := bearRegimeRaw ? bearConfirmCount + 1 : 0

bullRegime = bullRegimeRaw and bullConfirmCount >= i_confirmBars
bearRegime = bearRegimeRaw and bearConfirmCount >= i_confirmBars

regimeState = bullRegime ? 1 : bearRegime ? -1 : 0
prevRegimeState = regimeState[1]

f_cardwellRegime() =>
    _rsiVal = ta.rsi(i_rsiSrc, i_rsiLen)
    _trendMA = ta.sma(i_trendSrc, i_trendLen)
    _isUptrend = i_trendSrc > _trendMA
    _isDowntrend = i_trendSrc < _trendMA
    _inBullRange = _rsiVal >= i_bullLo and _rsiVal <= i_bullHi
    _inBearRange = _rsiVal >= i_bearLo and _rsiVal <= i_bearHi
    _bullRaw = _isUptrend and _inBullRange
    _bearRaw = _isDowntrend and _inBearRange
    var int _bullCnt = 0
    var int _bearCnt = 0
    _bullCnt := _bullRaw ? _bullCnt + 1 : 0
    _bearCnt := _bearRaw ? _bearCnt + 1 : 0
    _bull = _bullRaw and _bullCnt >= i_confirmBars
    _bear = _bearRaw and _bearCnt >= i_confirmBars
    _bull ? 1 : _bear ? -1 : 0

htfRegimeState = request.security(syminfo.tickerid, i_htfTF, f_cardwellRegime()[1], lookahead=barmerge.lookahead_on)
htfBullOk = not i_useHtf or htfRegimeState == 1
htfBearOk = not i_useHtf or htfRegimeState == -1

[_diPlus, _diMinus, adxVal] = ta.dmi(i_adxLen, i_adxLen)
chopOk = not i_useAdx or adxVal >= i_adxMin

// MACD filter
macdLine = ta.ema(close, i_macdFast) - ta.ema(close, i_macdSlow)
macdSignal = ta.sma(macdLine, i_macdSig)
macdBullOk = not i_useMacd or macdLine > macdSignal
macdBearOk = not i_useMacd or macdLine < macdSignal

// EWO turn filter
ewo = ta.sma(hl2, i_ewoFast) - ta.sma(hl2, i_ewoSlow)
ewoBullOk = not i_useEwo or ewo > ewo[1]
ewoBearOk = not i_useEwo or ewo < ewo[1]

rawLong  = regimeState == 1 and prevRegimeState != 1 and htfBullOk and chopOk and macdBullOk and ewoBullOk
rawShort = regimeState == -1 and prevRegimeState != -1 and htfBearOk and chopOk and macdBearOk and ewoBearOk

// ── TRADE STATE MACHINE (SL/TP close then resume) ───────────────
atrVal = ta.atr(i_atrLen)

f_slDist(float entry) =>
    i_riskMode == "Percent" ? entry * i_slPct / 100.0 : i_riskMode == "Pips" ? i_slPips * i_pipSize : atrVal * i_slMult

f_tpDist(float entry, float mult) =>
    i_riskMode == "Percent" ? entry * i_tpPct / 100.0 : i_riskMode == "Pips" ? i_tpPips * i_pipSize : atrVal * mult

var int   posDir = 0          // 1 long, -1 short, 0 flat
var float posEntry = na
var float posSL = na
var float posTP1 = na
var float posTP2 = na
var float posTP3 = na
var int   posOpenBar = na
var int   lastSignalDir = 0
var int   lastSignalBar = na

hitSL = false
hitTP = false
exitReason = ""

if posDir != 0
    if posDir == 1
        hitSL := low <= posSL
        hitTP := high >= posTP1   // primary TP for close (TP1); TP2/TP3 are visual targets
    else
        hitSL := high >= posSL
        hitTP := low <= posTP1

    if hitSL or hitTP
        exitReason := hitSL ? "SL" : "TP"
        // levels cleared below after alerts/visuals

bool canScan = posDir == 0 or not i_lockUntilExit

// Anti-flip gate on raw signals (blocks rapid long↔short flips)
longCandidate  = false
shortCandidate = false
if canScan and barstate.isconfirmed
    barsSince = na(lastSignalBar) ? 999999 : bar_index - lastSignalBar
    if rawLong
        flipBlocked = lastSignalDir == -1 and barsSince < i_minFlipBars
        sameLegBlocked = i_onePerLeg and lastSignalDir == 1 and barsSince < i_minFlipBars
        longCandidate := not flipBlocked and not sameLegBlocked
    if rawShort
        flipBlocked = lastSignalDir == 1 and barsSince < i_minFlipBars
        sameLegBlocked = i_onePerLeg and lastSignalDir == -1 and barsSince < i_minFlipBars
        shortCandidate := not flipBlocked and not sameLegBlocked

// Open new position only when flat
longSignal  = false
shortSignal = false
if posDir == 0 and barstate.isconfirmed
    if longCandidate
        longSignal := true
        posDir := 1
        posEntry := close
        posSL := posEntry - f_slDist(posEntry)
        posTP1 := posEntry + f_tpDist(posEntry, i_tp1Mult)
        posTP2 := posEntry + f_tpDist(posEntry, i_tp2Mult)
        posTP3 := posEntry + f_tpDist(posEntry, i_tp3Mult)
        posOpenBar := bar_index
        lastSignalDir := 1
        lastSignalBar := bar_index
    else if shortCandidate
        shortSignal := true
        posDir := -1
        posEntry := close
        posSL := posEntry + f_slDist(posEntry)
        posTP1 := posEntry - f_tpDist(posEntry, i_tp1Mult)
        posTP2 := posEntry - f_tpDist(posEntry, i_tp2Mult)
        posTP3 := posEntry - f_tpDist(posEntry, i_tp3Mult)
        posOpenBar := bar_index
        lastSignalDir := -1
        lastSignalBar := bar_index

closeLongSignal  = false
closeShortSignal = false
// Do not evaluate SL/TP on the entry bar
if posDir != 0 and not na(posOpenBar) and bar_index > posOpenBar and (hitSL or hitTP) and barstate.isconfirmed
    closeLongSignal  := posDir == 1
    closeShortSignal := posDir == -1

// ── ALERTS ──────────────────────────────────────────────────────
string longPayload = "{" + str.format(
 '"action":"{0}","ticker":"{1}","tf":"{2}","direction":"long","entry":"{3}","sl":"{4}","tp1":"{5}","tp2":"{6}","tp3":"{7}"',
 i_actionLong, syminfo.tickerid, timeframe.period,
 str.tostring(posEntry, format.mintick),
 str.tostring(posSL, format.mintick),
 str.tostring(posTP1, format.mintick),
 str.tostring(posTP2, format.mintick),
 str.tostring(posTP3, format.mintick)) + "}"

string shortPayload = "{" + str.format(
 '"action":"{0}","ticker":"{1}","tf":"{2}","direction":"short","entry":"{3}","sl":"{4}","tp1":"{5}","tp2":"{6}","tp3":"{7}"',
 i_actionShort, syminfo.tickerid, timeframe.period,
 str.tostring(posEntry, format.mintick),
 str.tostring(posSL, format.mintick),
 str.tostring(posTP1, format.mintick),
 str.tostring(posTP2, format.mintick),
 str.tostring(posTP3, format.mintick)) + "}"

string closeLongPayload = "{" + str.format(
 '"action":"{0}","ticker":"{1}","tf":"{2}","direction":"closelong","reason":"{3}"',
 i_actionCloseLong, syminfo.tickerid, timeframe.period, exitReason) + "}"

string closeShortPayload = "{" + str.format(
 '"action":"{0}","ticker":"{1}","tf":"{2}","direction":"closeshort","reason":"{3}"',
 i_actionCloseShort, syminfo.tickerid, timeframe.period, exitReason) + "}"

if longSignal
    alert(longPayload, alert.freq_once_per_bar_close)
if shortSignal
    alert(shortPayload, alert.freq_once_per_bar_close)
if closeLongSignal
    alert(closeLongPayload, alert.freq_once_per_bar_close)
if closeShortSignal
    alert(closeShortPayload, alert.freq_once_per_bar_close)

alertcondition(longSignal, "BUY Signal", "Cardwell Hybrid — BUY")
alertcondition(shortSignal, "SELL Signal", "Cardwell Hybrid — SELL")
alertcondition(closeLongSignal, "Close Long (SL/TP)", "Cardwell Hybrid — Close Long")
alertcondition(closeShortSignal, "Close Short (SL/TP)", "Cardwell Hybrid — Close Short")

// ── VISUALS ─────────────────────────────────────────────────────
bodyColor = bullRegime ? c_bullCandle : bearRegime ? c_bearCandle : c_neutCandle
plotcandle(open, high, low, close,
 title       = "Heatmap Candles",
 color       = i_showCandles ? bodyColor : na,
 wickcolor   = i_showCandles ? bodyColor : na,
 bordercolor = i_showCandles ? c_wickBorder : na)

plotshape(i_showSignals and longSignal, title="BUY", style=shape.labelup, location=location.belowbar, color=c_buySig, textcolor=color.white, text="BUY", size=size.small)
plotshape(i_showSignals and shortSignal, title="SELL", style=shape.labeldown, location=location.abovebar, color=c_sellSig, textcolor=color.white, text="SELL", size=size.small)
plotshape(i_showExitMarks and closeLongSignal and hitTP, title="TP Long", style=shape.xcross, location=location.abovebar, color=color.new(#26a69a, 0), size=size.tiny, text="TP")
plotshape(i_showExitMarks and closeLongSignal and hitSL, title="SL Long", style=shape.xcross, location=location.abovebar, color=c_slColor, size=size.tiny, text="SL")
plotshape(i_showExitMarks and closeShortSignal and hitTP, title="TP Short", style=shape.xcross, location=location.belowbar, color=color.new(#26a69a, 0), size=size.tiny, text="TP")
plotshape(i_showExitMarks and closeShortSignal and hitSL, title="SL Short", style=shape.xcross, location=location.belowbar, color=c_slColor, size=size.tiny, text="SL")

var line slLine = na
var line entryLine = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
var label slLbl = na
var label entryLbl = na
var label tp1Lbl = na
var label tp2Lbl = na
var label tp3Lbl = na
var linefill riskFill = na
var linefill rewardFill = na
var int levelEndBar = na

f_deleteLevels() =>
    line.delete(slLine)
    line.delete(entryLine)
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(tp3Line)
    label.delete(slLbl)
    label.delete(entryLbl)
    label.delete(tp1Lbl)
    label.delete(tp2Lbl)
    label.delete(tp3Lbl)
    linefill.delete(riskFill)
    linefill.delete(rewardFill)

if i_showLevels and (longSignal or shortSignal)
    f_deleteLevels()
    levelEndBar := bar_index + i_lineExtBars
    slLine    := line.new(bar_index, posSL, levelEndBar, posSL, color=c_slColor, style=line.style_solid, width=2)
    entryLine := line.new(bar_index, posEntry, levelEndBar, posEntry, color=c_entryColor, style=line.style_dashed, width=1)
    tp1Line   := line.new(bar_index, posTP1, levelEndBar, posTP1, color=c_tp1Color, style=line.style_dashed, width=1)
    tp2Line   := line.new(bar_index, posTP2, levelEndBar, posTP2, color=c_tp2Color, style=line.style_dashed, width=1)
    tp3Line   := line.new(bar_index, posTP3, levelEndBar, posTP3, color=c_tp3Color, style=line.style_dashed, width=1)
    slLbl    := label.new(levelEndBar, posSL, "SL " + str.tostring(posSL, format.mintick), style=label.style_label_left, color=c_slColor, textcolor=color.white, size=size.small)
    entryLbl := label.new(levelEndBar, posEntry, "Entry " + str.tostring(posEntry, format.mintick), style=label.style_label_left, color=c_entryColor, textcolor=color.white, size=size.small)
    tp1Lbl   := label.new(levelEndBar, posTP1, "TP1 " + str.tostring(posTP1, format.mintick), style=label.style_label_left, color=c_tp1Color, textcolor=color.white, size=size.small)
    tp2Lbl   := label.new(levelEndBar, posTP2, "TP2 " + str.tostring(posTP2, format.mintick), style=label.style_label_left, color=c_tp2Color, textcolor=color.white, size=size.small)
    tp3Lbl   := label.new(levelEndBar, posTP3, "TP3 " + str.tostring(posTP3, format.mintick), style=label.style_label_left, color=c_tp3Color, textcolor=color.white, size=size.small)
    riskFill   := linefill.new(slLine, entryLine, c_riskFill)
    rewardFill := linefill.new(entryLine, tp3Line, c_rewardFill)

// Extend active levels to current bar until exit
if posDir != 0 and not na(slLine) and not (hitSL or hitTP)
    levelEndBar := math.min(posOpenBar + i_lineExtBars, bar_index + 2)
    line.set_x2(slLine, levelEndBar)
    line.set_x2(entryLine, levelEndBar)
    line.set_x2(tp1Line, levelEndBar)
    line.set_x2(tp2Line, levelEndBar)
    line.set_x2(tp3Line, levelEndBar)
    label.set_x(slLbl, levelEndBar)
    label.set_x(entryLbl, levelEndBar)
    label.set_x(tp1Lbl, levelEndBar)
    label.set_x(tp2Lbl, levelEndBar)
    label.set_x(tp3Lbl, levelEndBar)

// Close position AFTER visuals/alerts for this bar
if closeLongSignal or closeShortSignal
    f_deleteLevels()
    posDir := 0
    posEntry := na
    posSL := na
    posTP1 := na
    posTP2 := na
    posTP3 := na
    posOpenBar := na
    // lastSignalDir kept so anti-flip cooldown still applies after exit

// ── DASHBOARD ───────────────────────────────────────────────────
f_barColor(float v) =>
    v >= 0.66 ? color.new(#26a69a, 0) : v >= 0.33 ? color.new(#f9a825, 0) : color.new(#ef5350, 0)

f_bar(float val, float maxVal) =>
    int filled = math.round(math.min(val / maxVal, 1.0) * 10)
    string bar = ""
    for i = 1 to 10
        bar += i <= filled ? "█" : "░"
    bar + "  " + str.tostring(math.round(val / maxVal * 100)) + "%"

var table dash = table.new(i_dashPos, 2, 16, border_width=1)

if i_showDash
    table.cell(dash, 0, 0, "Cardwell Hybrid Improved", text_color=c_dashValTxt, bgcolor=c_dashHeaderBg, text_size=size.normal)
    table.cell(dash, 1, 0, "", bgcolor=c_dashHeaderBg)

    table.cell(dash, 0, 1, "Regime", text_color=c_dashLabelTxt, bgcolor=c_dashBg, text_size=size.small)
    string regimeTxt = bullRegime ? "BULLISH" : bearRegime ? "BEARISH" : "NEUTRAL"
    color regimeClr = bullRegime ? c_bullCandle : bearRegime ? c_bearCandle : c_neutCandle
    table.cell(dash, 1, 1, regimeTxt, text_color=regimeClr, bgcolor=c_dashValBg, text_size=size.small)

    table.cell(dash, 0, 2, "Position", text_color=c_dashLabelTxt, bgcolor=c_dashBg, text_size=size.small)
    string posTxt = posDir == 1 ? "LONG OPEN" : posDir == -1 ? "SHORT OPEN" : "FLAT (scanning)"
    color posClr = posDir == 1 ? c_bullCandle : posDir == -1 ? c_bearCandle : c_neutCandle
    table.cell(dash, 1, 2, posTxt, text_color=posClr, bgcolor=c_dashValBg, text_size=size.small)

    table.cell(dash, 0, 3, "RSI", text_color=c_dashLabelTxt, bgcolor=c_dashBg, text_size=size.small)
    table.cell(dash, 1, 3, f_bar(rsiVal, 100), text_color=regimeClr, bgcolor=c_dashValBg, text_size=size.small)

    table.cell(dash, 0, 4, "MACD Filter", text_color=c_dashLabelTxt, bgcolor=c_dashBg, text_size=size.small)
    string macdTxt = not i_useMacd ? "OFF" : macdLine > macdSignal ? "BULL" : "BEAR"
    table.cell(dash, 1, 4, macdTxt, text_color=not i_useMacd ? c_neutCandle : macdLine > macdSignal ? c_bullCandle : c_bearCandle, bgcolor=c_dashValBg, text_size=size.small)

    table.cell(dash, 0, 5, "EWO Turn", text_color=c_dashLabelTxt, bgcolor=c_dashBg, text_size=size.small)
    string ewoTxt = not i_useEwo ? "OFF" : ewo > ewo[1] ? "UP" : "DOWN"
    table.cell(dash, 1, 5, ewoTxt, text_color=not i_useEwo ? c_neutCandle : ewo > ewo[1] ? c_bullCandle : c_bearCandle, bgcolor=c_dashValBg, text_size=size.small)

    table.cell(dash, 0, 6, "ADX / Chop", text_color=c_dashLabelTxt, bgcolor=c_dashBg, text_size=size.small)
    string chopTxt = not i_useAdx ? "OFF" : chopOk ? "PASS" : "BLOCKED"
    table.cell(dash, 1, 6, f_bar(adxVal, 100) + " " + chopTxt, text_color=f_barColor(adxVal / 100), bgcolor=c_dashValBg, text_size=size.small)

    table.cell(dash, 0, 7, "HTF Regime", text_color=c_dashLabelTxt, bgcolor=c_dashBg, text_size=size.small)
    string htfTxt = not i_useHtf ? "OFF" : htfRegimeState == 1 ? "BULLISH" : htfRegimeState == -1 ? "BEARISH" : "NEUTRAL"
    table.cell(dash, 1, 7, htfTxt, text_color=not i_useHtf ? c_neutCandle : htfRegimeState == 1 ? c_bullCandle : htfRegimeState == -1 ? c_bearCandle : c_neutCandle, bgcolor=c_dashValBg, text_size=size.small)

    table.cell(dash, 0, 8, "Anti-Flip Lock", text_color=c_dashLabelTxt, bgcolor=c_dashBg, text_size=size.small)
    int sinceSig = na(lastSignalBar) ? 999 : bar_index - lastSignalBar
    string lockTxt = sinceSig < i_minFlipBars ? "COOLDOWN " + str.tostring(i_minFlipBars - sinceSig) : "READY"
    table.cell(dash, 1, 8, lockTxt, text_color=sinceSig < i_minFlipBars ? c_bearCandle : c_bullCandle, bgcolor=c_dashValBg, text_size=size.small)

    table.cell(dash, 0, 9, "Risk Mode", text_color=c_dashLabelTxt, bgcolor=c_dashBg, text_size=size.small)
    table.cell(dash, 1, 9, i_riskMode, text_color=c_dashValTxt, bgcolor=c_dashValBg, text_size=size.small)

    table.cell(dash, 0, 10, "Entry / SL", text_color=c_dashLabelTxt, bgcolor=c_dashBg, text_size=size.small)
    table.cell(dash, 1, 10, na(posEntry) ? "-" : str.tostring(posEntry, format.mintick) + " / " + str.tostring(posSL, format.mintick), text_color=c_dashValTxt, bgcolor=c_dashValBg, text_size=size.small)

    table.cell(dash, 0, 11, "TP1", text_color=c_dashLabelTxt, bgcolor=c_dashBg, text_size=size.small)
    table.cell(dash, 1, 11, na(posTP1) ? "-" : str.tostring(posTP1, format.mintick), text_color=c_dashValTxt, bgcolor=c_dashValBg, text_size=size.small)

    table.cell(dash, 0, 12, "Trend MA", text_color=c_dashLabelTxt, bgcolor=c_dashBg, text_size=size.small)
    table.cell(dash, 1, 12, isUptrend ? "UP" : "DOWN", text_color=isUptrend ? c_bullCandle : c_bearCandle, bgcolor=c_dashValBg, text_size=size.small)

    table.cell(dash, 0, 13, "Confirm Bars", text_color=c_dashLabelTxt, bgcolor=c_dashBg, text_size=size.small)
    int confCnt = bullRegimeRaw ? bullConfirmCount : bearRegimeRaw ? bearConfirmCount : 0
    table.cell(dash, 1, 13, f_bar(math.min(confCnt, i_confirmBars), i_confirmBars), text_color=f_barColor(math.min(confCnt, i_confirmBars) / i_confirmBars), bgcolor=c_dashValBg, text_size=size.small)

    table.cell(dash, 0, 14, "ATR", text_color=c_dashLabelTxt, bgcolor=c_dashBg, text_size=size.small)
    table.cell(dash, 1, 14, str.tostring(atrVal, format.mintick), text_color=c_dashValTxt, bgcolor=c_dashValBg, text_size=size.small)

    table.cell(dash, 0, 15, "Last Price", text_color=c_dashLabelTxt, bgcolor=c_dashBg, text_size=size.small)
    table.cell(dash, 1, 15, str.tostring(close, format.mintick), text_color=c_dashValTxt, bgcolor=c_dashValBg, text_size=size.small)
