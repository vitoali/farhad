//@version=6
// Cardwell Hybrid Improved — STRATEGY (paste into TradingView → Pine Editor → Add to chart)
// Core: Cardwell RSI regime
// Filters: MACD direction + EWO turn + ADX chop + HTF regime
// Anti-flip cooldown + one position at a time
// SL/TP exit closes the trade, then strategy resumes scanning for the next signal
strategy(
     title              = "Cardwell Hybrid Improved Strategy",
     shorttitle         = "Cardwell Hybrid",
     overlay            = true,
     initial_capital    = 10000,
     default_qty_type   = strategy.percent_of_equity,
     default_qty_value  = 10,
     commission_type    = strategy.commission.percent,
     commission_value   = 0.04,
     pyramiding         = 0,
     process_orders_on_close = true,
     calc_on_every_tick = false,
     max_labels_count   = 500,
     max_lines_count    = 500)

//══════════════════════════════════════════════════════════════════
// INPUTS
//══════════════════════════════════════════════════════════════════
var string GRP_CORE = "1) Core — Cardwell"
i_rsiLen      = input.int(14, "RSI Length", minval=1, group=GRP_CORE)
i_rsiSrc      = input.source(close, "RSI Source", group=GRP_CORE)
i_trendLen    = input.int(50, "Trend MA Length", minval=1, group=GRP_CORE)
i_trendSrc    = input.source(close, "Trend Source", group=GRP_CORE)
i_bullLo      = input.int(40, "Bull Range Low", minval=0, maxval=100, group=GRP_CORE)
i_bullHi      = input.int(80, "Bull Range High", minval=0, maxval=100, group=GRP_CORE)
i_bearLo      = input.int(20, "Bear Range Low", minval=0, maxval=100, group=GRP_CORE)
i_bearHi      = input.int(60, "Bear Range High", minval=0, maxval=100, group=GRP_CORE)
i_confirmBars = input.int(3, "Regime Confirm Bars", minval=1, group=GRP_CORE)

var string GRP_HYB = "2) Hybrid Filters"
i_useMacd  = input.bool(true, "MACD Direction Filter", group=GRP_HYB)
i_macdFast = input.int(12, "MACD Fast", minval=1, group=GRP_HYB)
i_macdSlow = input.int(26, "MACD Slow", minval=1, group=GRP_HYB)
i_macdSig  = input.int(9, "MACD Signal", minval=1, group=GRP_HYB)
i_useEwo   = input.bool(true, "EWO Momentum Turn Filter", group=GRP_HYB)
i_ewoFast  = input.int(5, "EWO Fast", minval=1, group=GRP_HYB)
i_ewoSlow  = input.int(34, "EWO Slow", minval=1, group=GRP_HYB)
i_useAdx   = input.bool(true, "ADX Chop Filter", group=GRP_HYB)
i_adxLen   = input.int(14, "ADX Length", minval=1, group=GRP_HYB)
i_adxMin   = input.int(18, "ADX Min Strength", minval=0, maxval=100, group=GRP_HYB)
i_useHtf   = input.bool(true, "HTF Regime Confirmation", group=GRP_HYB)
i_htfTF    = input.timeframe("60", "HTF Timeframe", group=GRP_HYB)

var string GRP_ANTI = "3) Anti-Flip"
i_minFlipBars = input.int(8, "Min Bars Before Opposite / Same Leg", minval=0, group=GRP_ANTI)
i_onePerLeg   = input.bool(true, "Cooldown Also Blocks Same Direction", group=GRP_ANTI)

var string GRP_RISK = "4) SL / TP  (BTC→Percent | EUR→Pips 0.0001 | XAU→Pips pipSize≈1.0)"
i_riskMode = input.string("Percent", "SL/TP Mode", options=["ATR", "Percent", "Pips"], group=GRP_RISK, tooltip="BTC: Percent (SL3 TP5). EURUSD: Pips + pipSize 0.0001. Gold: Pips + pipSize 1.0")
i_atrLen   = input.int(14, "ATR Length", minval=1, group=GRP_RISK)
i_slMult   = input.float(1.5, "SL ATR Mult", minval=0.1, step=0.1, group=GRP_RISK)
i_tpMult   = input.float(2.0, "TP ATR Mult", minval=0.1, step=0.1, group=GRP_RISK)
i_slPct    = input.float(3.0, "SL Percent", minval=0.1, step=0.1, group=GRP_RISK)
i_tpPct    = input.float(5.0, "TP Percent", minval=0.1, step=0.1, group=GRP_RISK)
i_slPips   = input.float(5.0, "SL Pips", minval=0.1, step=0.1, group=GRP_RISK)
i_tpPips   = input.float(5.0, "TP Pips", minval=0.1, step=0.1, group=GRP_RISK)
i_pipSize  = input.float(0.0001, "Pip Size", minval=0.00001, step=0.0001, group=GRP_RISK)

var string GRP_TRADE = "5) Trade Direction"
i_allowLong  = input.bool(true, "Allow Long", group=GRP_TRADE)
i_allowShort = input.bool(true, "Allow Short", group=GRP_TRADE)

var string GRP_VIS = "6) Visuals"
i_showCandles = input.bool(true, "Color Candles by Regime", group=GRP_VIS)
i_showSignals = input.bool(true, "Show Entry Labels", group=GRP_VIS)
i_showLevels  = input.bool(true, "Show SL/TP Lines", group=GRP_VIS)
i_showDash    = input.bool(true, "Show Dashboard", group=GRP_VIS)
i_dashPos     = input.string(position.top_right, "Dashboard Position", options=[position.top_right, position.top_left, position.bottom_right, position.bottom_left], group=GRP_VIS)

var string GRP_COL = "7) Colors"
c_bull = input.color(color.new(#26a69a, 0), "Bull", group=GRP_COL)
c_bear = input.color(color.new(#ef5350, 0), "Bear", group=GRP_COL)
c_neut = input.color(color.new(#787b86, 0), "Neutral", group=GRP_COL)
c_buy  = input.color(#2196f3, "Buy Label", group=GRP_COL)
c_sell = input.color(#ff9800, "Sell Label", group=GRP_COL)
c_sl   = input.color(#ef5350, "SL", group=GRP_COL)
c_tp   = input.color(#26a69a, "TP", group=GRP_COL)
c_ent  = input.color(#2196f3, "Entry", group=GRP_COL)

//══════════════════════════════════════════════════════════════════
// CARDWELL REGIME
//══════════════════════════════════════════════════════════════════
rsiVal   = ta.rsi(i_rsiSrc, i_rsiLen)
trendMA  = ta.sma(i_trendSrc, i_trendLen)
isUp     = i_trendSrc > trendMA
isDown   = i_trendSrc < trendMA

bullRaw = isUp and rsiVal >= i_bullLo and rsiVal <= i_bullHi
bearRaw = isDown and rsiVal >= i_bearLo and rsiVal <= i_bearHi

var int bullCnt = 0
var int bearCnt = 0
bullCnt := bullRaw ? bullCnt + 1 : 0
bearCnt := bearRaw ? bearCnt + 1 : 0

bullRegime = bullRaw and bullCnt >= i_confirmBars
bearRegime = bearRaw and bearCnt >= i_confirmBars
regime     = bullRegime ? 1 : bearRegime ? -1 : 0
prevRegime = regime[1]

f_htfRegime() =>
    _r  = ta.rsi(i_rsiSrc, i_rsiLen)
    _ma = ta.sma(i_trendSrc, i_trendLen)
    _up = i_trendSrc > _ma
    _dn = i_trendSrc < _ma
    _br = _up and _r >= i_bullLo and _r <= i_bullHi
    _er = _dn and _r >= i_bearLo and _r <= i_bearHi
    var int _bc = 0
    var int _ec = 0
    _bc := _br ? _bc + 1 : 0
    _ec := _er ? _ec + 1 : 0
    _br and _bc >= i_confirmBars ? 1 : _er and _ec >= i_confirmBars ? -1 : 0

htfRegime = request.security(syminfo.tickerid, i_htfTF, f_htfRegime()[1], lookahead=barmerge.lookahead_on)
htfLongOk  = not i_useHtf or htfRegime == 1
htfShortOk = not i_useHtf or htfRegime == -1

[_, _, adxVal] = ta.dmi(i_adxLen, i_adxLen)
chopOk = not i_useAdx or adxVal >= i_adxMin

macdLine = ta.ema(close, i_macdFast) - ta.ema(close, i_macdSlow)
macdSig  = ta.sma(macdLine, i_macdSig)
macdLongOk  = not i_useMacd or macdLine > macdSig
macdShortOk = not i_useMacd or macdLine < macdSig

ewo = ta.sma(hl2, i_ewoFast) - ta.sma(hl2, i_ewoSlow)
ewoLongOk  = not i_useEwo or ewo > ewo[1]
ewoShortOk = not i_useEwo or ewo < ewo[1]

rawLong  = regime == 1 and prevRegime != 1 and htfLongOk and chopOk and macdLongOk and ewoLongOk
rawShort = regime == -1 and prevRegime != -1 and htfShortOk and chopOk and macdShortOk and ewoShortOk

//══════════════════════════════════════════════════════════════════
// ANTI-FLIP + ENTRIES (only when flat — after SL/TP, scan resumes)
//══════════════════════════════════════════════════════════════════
var int lastSigDir = 0
var int lastSigBar = na

flat = strategy.position_size == 0
barsSince = na(lastSigBar) ? 999999 : bar_index - lastSigBar

longBlocked  = (lastSigDir == -1 and barsSince < i_minFlipBars) or (i_onePerLeg and lastSigDir == 1 and barsSince < i_minFlipBars)
shortBlocked = (lastSigDir == 1 and barsSince < i_minFlipBars) or (i_onePerLeg and lastSigDir == -1 and barsSince < i_minFlipBars)

longSignal  = i_allowLong and flat and rawLong and not longBlocked and barstate.isconfirmed
shortSignal = i_allowShort and flat and rawShort and not shortBlocked and barstate.isconfirmed

// SL / TP distances
atrVal = ta.atr(i_atrLen)

f_slDist(float entry) =>
    switch i_riskMode
        "Percent" => entry * i_slPct / 100.0
        "Pips"    => i_slPips * i_pipSize
        => atrVal * i_slMult

f_tpDist(float entry) =>
    switch i_riskMode
        "Percent" => entry * i_tpPct / 100.0
        "Pips"    => i_tpPips * i_pipSize
        => atrVal * i_tpMult

var float entryPx = na
var float slPx    = na
var float tpPx    = na

if longSignal
    entryPx := close
    slPx    := entryPx - f_slDist(entryPx)
    tpPx    := entryPx + f_tpDist(entryPx)
    lastSigDir := 1
    lastSigBar := bar_index
    strategy.entry("Long", strategy.long, comment="BUY")
    strategy.exit("XL", from_entry="Long", stop=slPx, limit=tpPx, comment_loss="SL", comment_profit="TP")

if shortSignal
    entryPx := close
    slPx    := entryPx + f_slDist(entryPx)
    tpPx    := entryPx - f_tpDist(entryPx)
    lastSigDir := -1
    lastSigBar := bar_index
    strategy.entry("Short", strategy.short, comment="SELL")
    strategy.exit("XS", from_entry="Short", stop=slPx, limit=tpPx, comment_loss="SL", comment_profit="TP")

// Detect strategy flat transition (SL/TP filled) → clear levels, ready for next signal
wasInTrade = strategy.position_size[1] != 0
nowFlat    = strategy.position_size == 0
closedNow  = wasInTrade and nowFlat
closedLong  = closedNow and strategy.position_size[1] > 0
closedShort = closedNow and strategy.position_size[1] < 0

if closedNow
    entryPx := na
    slPx    := na
    tpPx    := na
    // lastSigDir / lastSigBar kept → anti-flip cooldown continues after exit

//══════════════════════════════════════════════════════════════════
// ALERTS
//══════════════════════════════════════════════════════════════════
if longSignal
    alert('{"action":"long","ticker":"' + syminfo.tickerid + '","tf":"' + timeframe.period + '","entry":"' + str.tostring(entryPx) + '","sl":"' + str.tostring(slPx) + '","tp":"' + str.tostring(tpPx) + '"}', alert.freq_once_per_bar_close)
if shortSignal
    alert('{"action":"short","ticker":"' + syminfo.tickerid + '","tf":"' + timeframe.period + '","entry":"' + str.tostring(entryPx) + '","sl":"' + str.tostring(slPx) + '","tp":"' + str.tostring(tpPx) + '"}', alert.freq_once_per_bar_close)
if closedLong
    alert('{"action":"closelong","ticker":"' + syminfo.tickerid + '","tf":"' + timeframe.period + '"}', alert.freq_once_per_bar_close)
if closedShort
    alert('{"action":"closeshort","ticker":"' + syminfo.tickerid + '","tf":"' + timeframe.period + '"}', alert.freq_once_per_bar_close)

//══════════════════════════════════════════════════════════════════
// VISUALS
//══════════════════════════════════════════════════════════════════
bodyColor = bullRegime ? c_bull : bearRegime ? c_bear : c_neut
plotcandle(i_showCandles ? open : na, i_showCandles ? high : na, i_showCandles ? low : na, i_showCandles ? close : na, title="Regime Candles", color=bodyColor, wickcolor=bodyColor, bordercolor=color.black)

plotshape(i_showSignals and longSignal,  title="BUY",  style=shape.labelup,   location=location.belowbar, color=c_buy,  textcolor=color.white, text="BUY",  size=size.small)
plotshape(i_showSignals and shortSignal, title="SELL", style=shape.labeldown, location=location.abovebar, color=c_sell, textcolor=color.white, text="SELL", size=size.small)

plot(i_showLevels and strategy.position_size != 0 ? slPx : na, "SL", color=c_sl, style=plot.style_linebr, linewidth=2)
plot(i_showLevels and strategy.position_size != 0 ? tpPx : na, "TP", color=c_tp, style=plot.style_linebr, linewidth=2)
plot(i_showLevels and strategy.position_size != 0 ? entryPx : na, "Entry", color=c_ent, style=plot.style_linebr, linewidth=1)

//══════════════════════════════════════════════════════════════════
// DASHBOARD
//══════════════════════════════════════════════════════════════════
f_bar(float val, float maxVal) =>
    int filled = math.round(math.min(val / maxVal, 1.0) * 10)
    string b = ""
    for i = 1 to 10
        b += i <= filled ? "█" : "░"
    b + " " + str.tostring(math.round(val / maxVal * 100)) + "%"

var table dash = table.new(i_dashPos, 2, 12, border_width=1)
c_bg  = color.new(#0a0f1a, 10)
c_hdr = color.new(#14b5cb, 20)
c_lbl = color.new(#ffffff, 30)
c_val = color.new(#0d1117, 0)
c_txt = color.white

if i_showDash and barstate.islast
    table.cell(dash, 0, 0, "Cardwell Hybrid Strategy", text_color=c_txt, bgcolor=c_hdr, text_size=size.normal)
    table.merge_cells(dash, 0, 0, 1, 0)

    posTxt = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT (scanning)"
    posClr = strategy.position_size > 0 ? c_bull : strategy.position_size < 0 ? c_bear : c_neut
    regTxt = bullRegime ? "BULLISH" : bearRegime ? "BEARISH" : "NEUTRAL"
    regClr = bullRegime ? c_bull : bearRegime ? c_bear : c_neut
    cdLeft = barsSince < i_minFlipBars ? i_minFlipBars - barsSince : 0

    table.cell(dash, 0, 1, "Position", text_color=c_lbl, bgcolor=c_bg, text_size=size.small)
    table.cell(dash, 1, 1, posTxt, text_color=posClr, bgcolor=c_val, text_size=size.small)
    table.cell(dash, 0, 2, "Regime", text_color=c_lbl, bgcolor=c_bg, text_size=size.small)
    table.cell(dash, 1, 2, regTxt, text_color=regClr, bgcolor=c_val, text_size=size.small)
    table.cell(dash, 0, 3, "RSI", text_color=c_lbl, bgcolor=c_bg, text_size=size.small)
    table.cell(dash, 1, 3, f_bar(rsiVal, 100), text_color=regClr, bgcolor=c_val, text_size=size.small)
    table.cell(dash, 0, 4, "MACD", text_color=c_lbl, bgcolor=c_bg, text_size=size.small)
    table.cell(dash, 1, 4, not i_useMacd ? "OFF" : macdLine > macdSig ? "BULL" : "BEAR", text_color=not i_useMacd ? c_neut : macdLine > macdSig ? c_bull : c_bear, bgcolor=c_val, text_size=size.small)
    table.cell(dash, 0, 5, "EWO", text_color=c_lbl, bgcolor=c_bg, text_size=size.small)
    table.cell(dash, 1, 5, not i_useEwo ? "OFF" : ewo > ewo[1] ? "UP" : "DOWN", text_color=not i_useEwo ? c_neut : ewo > ewo[1] ? c_bull : c_bear, bgcolor=c_val, text_size=size.small)
    table.cell(dash, 0, 6, "ADX", text_color=c_lbl, bgcolor=c_bg, text_size=size.small)
    table.cell(dash, 1, 6, not i_useAdx ? "OFF" : (chopOk ? "PASS " : "BLOCK ") + str.tostring(adxVal, "#.#"), text_color=not i_useAdx ? c_neut : chopOk ? c_bull : c_bear, bgcolor=c_val, text_size=size.small)
    table.cell(dash, 0, 7, "HTF", text_color=c_lbl, bgcolor=c_bg, text_size=size.small)
    table.cell(dash, 1, 7, not i_useHtf ? "OFF" : htfRegime == 1 ? "BULL" : htfRegime == -1 ? "BEAR" : "NEUT", text_color=not i_useHtf ? c_neut : htfRegime == 1 ? c_bull : htfRegime == -1 ? c_bear : c_neut, bgcolor=c_val, text_size=size.small)
    table.cell(dash, 0, 8, "Cooldown", text_color=c_lbl, bgcolor=c_bg, text_size=size.small)
    table.cell(dash, 1, 8, cdLeft > 0 ? "WAIT " + str.tostring(cdLeft) : "READY", text_color=cdLeft > 0 ? c_bear : c_bull, bgcolor=c_val, text_size=size.small)
    table.cell(dash, 0, 9, "Risk", text_color=c_lbl, bgcolor=c_bg, text_size=size.small)
    table.cell(dash, 1, 9, i_riskMode, text_color=c_txt, bgcolor=c_val, text_size=size.small)
    table.cell(dash, 0, 10, "SL / TP", text_color=c_lbl, bgcolor=c_bg, text_size=size.small)
    table.cell(dash, 1, 10, na(slPx) ? "-" : str.tostring(slPx, format.mintick) + " / " + str.tostring(tpPx, format.mintick), text_color=c_txt, bgcolor=c_val, text_size=size.small)
    table.cell(dash, 0, 11, "Net P&L", text_color=c_lbl, bgcolor=c_bg, text_size=size.small)
    table.cell(dash, 1, 11, str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit >= 0 ? c_bull : c_bear, bgcolor=c_val, text_size=size.small)
