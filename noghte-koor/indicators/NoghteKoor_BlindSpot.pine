//@version=5
// ═══════════════════════════════════════════════════════════════════════════
// استراتژی نقطه کور (Blind Spot) — نسخه آموزشی
// مبتنی بر آموزه‌های رفتارشناسی حرکت قیمت (سعید خاکستر)
// و ویدیوهای آموزشی نقطه کور (کلاسیک + لایو)
//
// نمایش:
//   1) TH  = توان حرکتی ≈ 0.6666% قیمت جاری
//   2) ATR = میانگین True Range
//   3) IDR = میانگین Daily/TF Range (High-Low)
//   4) Live Range کندل جاری + درصد پرشدگی
//   5) ناحیه نقطه کور کلاسیک (شکست سطح + فاصله یک رنج + اعتبار ۱ کندل)
//   6) ناحیه نقطه کور لایو (پر شدن زودهنگام رنج کندل جاری)
// ═══════════════════════════════════════════════════════════════════════════
indicator("نقطه کور | Blind Spot (TH/ATR/IDR)", overlay=true, max_boxes_count=100, max_lines_count=100, max_labels_count=100)

// ─── Inputs ────────────────────────────────────────────────────────────────
grpCalc = "محاسبات رنج"
atrLen          = input.int(14, "دوره ATR", minval=1, group=grpCalc)
idrLen          = input.int(20, "دوره IDR (میانگین High-Low)", minval=1, group=grpCalc)
thPercent       = input.float(0.6666, "ضریب توان حرکتی TH (% قیمت)", step=0.0001, group=grpCalc)
rangeSource     = input.string("Auto (Max of TH/ATR/IDR)", "منبع فاصله نقطه کور",
     options=["Auto (Max of TH/ATR/IDR)", "TH", "ATR", "IDR"], group=grpCalc)

grpClassic = "نقطه کور کلاسیک"
useClassic      = input.bool(true, "فعال‌سازی نقطه کور کلاسیک", group=grpClassic)
swingLen        = input.int(5, "طول سوئینگ برای تشخیص سطح", minval=1, group=grpClassic)
minBreakBodyPct = input.float(50.0, "حداقل درصد بدنه کندل شکست نسبت به ATR", minval=0, group=grpClassic)
classicValidBars= input.int(1, "اعتبار اردر (تعداد کندل بعدی)", minval=1, group=grpClassic)
entryOffsetPct  = input.float(80.0, "ورود در چند٪ فاصله رنج (مثلاً ۸۰)", minval=50, maxval=100, group=grpClassic)
tpMult          = input.float(2.0, "تارگت × رنج", step=0.1, group=grpClassic)
slMode          = input.string("Remainder to 100%", "مد استاپ",
     options=["Remainder to 100%", "Beyond swing"], group=grpClassic)

grpLive = "نقطه کور لایو"
useLive         = input.bool(true, "فعال‌سازی نقطه کور لایو", group=grpLive)
liveFillPct     = input.float(100.0, "حداقل پرشدگی رنج لایو (%)", minval=50, group=grpLive)
minRemainPct    = input.float(25.0, "حداقل زمان باقی‌مانده کندل (%)", minval=0, group=grpLive)
showPrevOC      = input.bool(true, "نمایش ناحیه Open/Close کندل قبلی", group=grpLive)

grpVis = "نمایش"
showDash        = input.bool(true, "پنل داشبورد", group=grpVis)
showSignals     = input.bool(true, "لیبل سیگنال", group=grpVis)
bullColor       = input.color(color.new(#22c55e, 0), "رنگ صعودی", group=grpVis)
bearColor       = input.color(color.new(#ef4444, 0), "رنگ نزولی", group=grpVis)
zoneColor       = input.color(color.new(#f59e0b, 75), "رنگ ناحیه نقطه کور", group=grpVis)
levelColor      = input.color(color.new(#38bdf8, 0), "رنگ سطح شکسته‌شده", group=grpVis)

// ─── Core metrics ───────────────────────────────────────────────────────────
trVal   = ta.tr(true)
atrVal  = ta.atr(atrLen)
idrVal  = ta.sma(high - low, idrLen)
thVal   = close * (thPercent / 100.0)

autoRange = math.max(thVal, math.max(atrVal, idrVal))
rangeVal  = switch rangeSource
    "TH"  => thVal
    "ATR" => atrVal
    "IDR" => idrVal
    => autoRange

liveRange = high - low
liveFill  = rangeVal > 0 ? (liveRange / rangeVal) * 100.0 : 0.0

// زمان باقی‌مانده کندل (تقریبی بر اساس تایم‌فریم)
tfSecs     = timeframe.in_seconds()
barElapsed = time_close > time ? (timenow - time) / 1000.0 : tfSecs
remainPct  = tfSecs > 0 ? math.max(0.0, 100.0 * (1.0 - barElapsed / tfSecs)) : 0.0

// ─── Helpers ────────────────────────────────────────────────────────────────
pipSize() =>
    syminfo.mintick * (syminfo.type == "forex" ? (syminfo.mintick < 0.001 ? 10.0 : 1.0) : 1.0)

toPips(v) =>
    v / pipSize()

f_body(cOpen, cClose) =>
    math.abs(cClose - cOpen)

f_isLongBar(cOpen, cHigh, cLow, cClose, atrRef) =>
    (cHigh - cLow) >= atrRef * (minBreakBodyPct / 100.0)

// ─── Classic Blind Spot detection ───────────────────────────────────────────
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float resistLevel = na
var float supportLevel = na
var int   resistBar = na
var int   supportBar = na

if not na(ph)
    resistLevel := ph
    resistBar := bar_index - swingLen
if not na(pl)
    supportLevel := pl
    supportBar := bar_index - swingLen

// Breakout confirmation on closed bars
brokeDown = useClassic and not na(resistLevel) and close[1] < resistLevel and close[2] >= resistLevel and f_isLongBar(open[1], high[1], low[1], close[1], atrVal[1])
brokeUp   = useClassic and not na(supportLevel) and close[1] > supportLevel and close[2] <= supportLevel and f_isLongBar(open[1], high[1], low[1], close[1], atrVal[1])

var float bsLevel = na
var int   bsDir = 0          // 1 = long (buy limit after upside break), -1 = short
var int   bsBreakBar = na
var float bsRangeAtBreak = na
var bool  bsArmed = false
var bool  bsTriggered = false
var box   bsBox = na
var line  bsLevelLine = na
var line  bsEntryLine = na
var line  bsSlLine = na
var line  bsTpLine = na

if brokeDown
    bsLevel := resistLevel
    bsDir := -1
    bsBreakBar := bar_index - 1
    bsRangeAtBreak := rangeVal[1]
    bsArmed := false
    bsTriggered := false

if brokeUp
    bsLevel := supportLevel
    bsDir := 1
    bsBreakBar := bar_index - 1
    bsRangeAtBreak := rangeVal[1]
    bsArmed := false
    bsTriggered := false

// Arm when distance from level reaches ~1 range
if not na(bsLevel) and not na(bsBreakBar) and not bsTriggered
    dist = bsDir == -1 ? (bsLevel - low) : (high - bsLevel)
    if dist >= bsRangeAtBreak
        bsArmed := true

// Validity window = next N bars after the breakout candle
barsSinceBreak = not na(bsBreakBar) ? bar_index - bsBreakBar : 999999
inValidWindow  = bsArmed and barsSinceBreak >= 1 and barsSinceBreak <= classicValidBars

entryPrice = na
slPrice    = na
tpPrice    = na
if not na(bsLevel) and not na(bsRangeAtBreak)
    offset = bsRangeAtBreak * ((100.0 - entryOffsetPct) / 100.0)
    if bsDir == -1
        entryPrice := bsLevel - offset
        rem = bsRangeAtBreak - offset
        slPrice := slMode == "Remainder to 100%" ? entryPrice + rem : bsLevel + rem
        tpPrice := entryPrice - bsRangeAtBreak * tpMult
    else if bsDir == 1
        entryPrice := bsLevel + offset
        rem = bsRangeAtBreak - offset
        slPrice := slMode == "Remainder to 100%" ? entryPrice - rem : bsLevel - rem
        tpPrice := entryPrice + bsRangeAtBreak * tpMult

// Trigger if price touches entry during valid window
if inValidWindow and not bsTriggered and not na(entryPrice)
    hit = bsDir == -1 ? high >= entryPrice : low <= entryPrice
    if hit
        bsTriggered := true
        if showSignals
            label.new(bar_index, entryPrice, bsDir == -1 ? "Sell Limit BS" : "Buy Limit BS",
                 style=bsDir == -1 ? label.style_label_down : label.style_label_up,
                 color=bsDir == -1 ? bearColor : bullColor, textcolor=color.white, size=size.small)

// Expire
if not na(bsBreakBar) and barsSinceBreak > classicValidBars and not bsTriggered
    bsArmed := false

// Draw classic zone
if barstate.islast and useClassic and not na(bsLevel) and not na(entryPrice) and bsArmed and inValidWindow
    if not na(bsBox)
        box.delete(bsBox)
    if not na(bsLevelLine)
        line.delete(bsLevelLine)
    if not na(bsEntryLine)
        line.delete(bsEntryLine)
    if not na(bsSlLine)
        line.delete(bsSlLine)
    if not na(bsTpLine)
        line.delete(bsTpLine)
    topZ = math.max(bsLevel, entryPrice)
    botZ = math.min(bsLevel, entryPrice)
    bsBox := box.new(bar_index - 3, topZ, bar_index + 3, botZ, bgcolor=zoneColor, border_color=color.new(#f59e0b, 0))
    bsLevelLine := line.new(bar_index - 10, bsLevel, bar_index + 5, bsLevel, color=levelColor, style=line.style_dashed, width=2)
    bsEntryLine := line.new(bar_index - 5, entryPrice, bar_index + 5, entryPrice, color=bsDir == -1 ? bearColor : bullColor, width=2)
    bsSlLine := line.new(bar_index - 5, slPrice, bar_index + 5, slPrice, color=color.new(#ef4444, 0), style=line.style_dotted)
    bsTpLine := line.new(bar_index - 5, tpPrice, bar_index + 5, tpPrice, color=color.new(#22c55e, 0), style=line.style_dotted)

// ─── Live Blind Spot ────────────────────────────────────────────────────────
prevOCTop = math.max(open[1], close[1])
prevOCBot = math.min(open[1], close[1])
liveReady = useLive and liveFill >= liveFillPct and remainPct >= minRemainPct

var box liveBox = na
var label liveLab = na

if barstate.islast and useLive
    if not na(liveBox)
        box.delete(liveBox)
    if not na(liveLab)
        label.delete(liveLab)
    if showPrevOC
        liveBox := box.new(bar_index - 1, prevOCTop, bar_index + 2, prevOCBot,
             bgcolor=liveReady ? color.new(#a855f7, 70) : color.new(#64748b, 85),
             border_color=liveReady ? color.new(#a855f7, 0) : color.new(#64748b, 0))
    if liveReady
        liveLab := label.new(bar_index, high, "Live Blind Spot READY\nReturn to Prev O/C",
             style=label.style_label_down, color=color.new(#a855f7, 0), textcolor=color.white, size=size.small)

liveTouch = liveReady and low <= prevOCTop and high >= prevOCBot
plotshape(liveTouch and showSignals, title="Live BS Touch", style=shape.diamond, location=location.belowbar, color=color.new(#a855f7, 0), size=size.tiny)

// ─── Dashboard ──────────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 9, bgcolor=color.new(#0f172a, 15), border_width=1, border_color=color.new(#334155, 0))
if showDash and barstate.islast
    table.cell(dash, 0, 0, "متریک", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 0, "مقدار (پیپ)", text_color=color.silver, text_size=size.small)
    table.cell(dash, 0, 1, "TH توان حرکتی", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(toPips(thVal), "#.#"), text_color=#38bdf8, text_size=size.small)
    table.cell(dash, 0, 2, "ATR", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(toPips(atrVal), "#.#"), text_color=#38bdf8, text_size=size.small)
    table.cell(dash, 0, 3, "IDR", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(toPips(idrVal), "#.#"), text_color=#38bdf8, text_size=size.small)
    table.cell(dash, 0, 4, "Range منبع", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(toPips(rangeVal), "#.#"), text_color=#fbbf24, text_size=size.small)
    table.cell(dash, 0, 5, "Live Range", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(toPips(liveRange), "#.#") + " (" + str.tostring(liveFill, "#.#") + "%)", text_color=liveReady ? #22c55e : color.white, text_size=size.small)
    table.cell(dash, 0, 6, "زمان باقی‌مانده", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(remainPct, "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 7, "کلاسیک BS", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 7, inValidWindow ? (bsDir == -1 ? "SELL ZONE" : "BUY ZONE") : "—", text_color=inValidWindow ? #f59e0b : color.gray, text_size=size.small)
    table.cell(dash, 0, 8, "لایو BS", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 8, liveReady ? "READY" : "WAIT", text_color=liveReady ? #a855f7 : color.gray, text_size=size.small)

// ─── Alerts ─────────────────────────────────────────────────────────────────
alertcondition(inValidWindow and not bsTriggered, title="Classic Blind Spot Armed", message="نقطه کور کلاسیک فعال شد — اردر لیمیت روی ناحیه")
alertcondition(bsTriggered, title="Classic Blind Spot Triggered", message="نقطه کور کلاسیک تریگر شد")
alertcondition(liveReady, title="Live Blind Spot Ready", message="نقطه کور لایو آماده — انتظار بازگشت به O/C قبلی")
alertcondition(liveTouch, title="Live Blind Spot Touch", message="قیمت ناحیه نقطه کور لایو را تاچ کرد")
